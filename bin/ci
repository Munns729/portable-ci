#!/usr/bin/env bash
# portable-ci — run your project's CI checks from one config, locally and in CI.
#
# The same `.localci` config drives your local runs and your GitHub Actions run,
# so the two can never drift. Because it runs locally it can also do things a
# server runner can't: install a pre-push git hook, scope checks to changed
# files, and publish a commit status that Claude Code's CI indicator reflects.
#
# Quick start:
#   ci init      # scaffold a .localci for this project (auto-detects your tools)
#   ci run       # run every check in .localci; non-zero exit if any fails
#
# Usage:
#   ci [run] [--config PATH] [--since REF] [--publish-status] [--context NAME] [--repo OWNER/REPO] [--list|--dry-run] [--no-lock]
#   ci run --shard I/K                 # run shard I (0-based) of K; writes .portable-ci/shard-result.json
#   ci attest-merge --head SHA R1.json ... Rk.json   # aggregate K shard results into ONE attestation, or REFUSE
#   ci init [--config PATH]
#   ci doctor [--config PATH]
#   ci install-hook [pre-push|pre-commit|claude]   # claude wires ci run into an AI agent's own loop
#   ci status [--repo OWNER/REPO]      # what CI does GitHub actually have recorded for HEAD?
#   ci quota [--repo OWNER/REPO]       # remaining GitHub Actions minutes for the repo owner
#   ci resolve-repo [--repo OWNER/REPO]
#   ci resolve-context [--context NAME]
#   ci --version | --help
#
# Env: PORTABLE_CI_REPO=owner/repo sets the repo for --publish-status when the
# git remote is not a github.com URL (proxied checkouts, GitHub Enterprise, forks).
#
# Provenance: a local `--publish-status` run publishes under context
# `portable-ci/local` and a description marked "local backup", so a recorded
# backup can never be mistaken for a hosted GitHub Actions run (context
# `portable-ci`). `ci status` reads back HEAD's checks and labels each one.
#
# Config format (.localci) — a shell fragment that calls `step`:
#   min_version 0.3.0                # optional: minimum portable-ci required

#   step_timeout 300                 # optional: cap subsequent steps at 300s
#   step "lint"  ruff check src/
#   step "types" mypy
#   step "test"  pytest -q
# Each `step` runs a command; any non-zero exit fails the run. For compound
# commands, wrap in a shell: step "build" bash -c "make && make test".
# `step_soft "name" cmd...` is advisory: reported, but never fails the run or a
# published status (e.g. an LLM adversarial review). `step_timeout N` caps every
# step declared after it at N seconds (needs a `timeout` binary; 0 = no limit).
# `step_unless_only GLOBS name cmd...` SKIPS the step when every changed file
# (from --since / the pre-push hook) matches one of the space-separated GLOBS;
# `step_when_only GLOBS name cmd...` runs ONLY then. Together they express a
# docs-only fast path: skip the suite, run the docs guards. With no changed-file
# scope (no --since, or an empty diff) unless_only steps RUN and when_only steps
# are not run — the safe direction. Only an unless_only skip is a coverage
# reduction; it is named in the attestation ("skipped by path predicate: test").
# `serialize repo|machine|off [TIMEOUT]` sets the run lock scope (default: repo —
# one `ci run` at a time per repository, shared across its worktrees; see
# "run lock" below). Must appear before the first `step`.
# Every run ends with a SHA-stamped attestation line recording what was verified,
# and writes a durable run record (see "durable run record" below).
# `ci run --rerun-of SHA` (SHA must be the current HEAD) re-runs a commit that
# already has a failed record; if it now passes the verdict is `passed-on-rerun`,
# a weaker verdict than `passed`, and the attestation lists what `flaked:`.
set -uo pipefail

# Bump this on every release that changes behaviour. It is the ONLY signal a
# consumer has that their install is behind — `install.sh` installs once from the
# moving `v1` tag and nothing re-checks afterwards.
#
# It has silently failed at that job before: 0.1.0 stayed pinned across seven
# feature PRs (advisory steps, install trust, quota preflight, doctor
# interpreter warning, `ci quota`), so an install predating them reported the
# same version as one containing them. A consumer repo hit exactly this on
# 2026-07-20 — wrote a `step_soft` config, and the installed `ci` errored
# `step_soft: command not found` while `ci --version` claimed parity with HEAD.
VERSION="0.10.0"

# ---------- presentation ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_BOLD=""; C_GREEN=""; C_RED=""; C_DIM=""; C_RESET=""
fi

# ---------- state ----------
MODE="run"
CONFIG="${PORTABLE_CI_CONFIG:-.localci}"
CONFIG_EXPLICIT=0; [ -n "${PORTABLE_CI_CONFIG:-}" ] && CONFIG_EXPLICIT=1
SINCE=""
PUBLISH_STATUS=0
STATUS_CONTEXT="${PORTABLE_CI_CONTEXT:-}"   # empty => choose default by provenance (see effective_context)
REPO="${PORTABLE_CI_REPO:-}"   # owner/repo override for status publishing
FAIL=0
MISSING=0
ADVISORY_FAIL=0        # advisory steps that failed — reported, but never gate the run
SHOW_ONLY=""           # "" runs steps; "list"/"dry-run" print them without executing
STEP_TIMEOUT=0         # per-step wall-clock cap in seconds (0 = no limit); set by `step_timeout`
SKIPPED=0              # hard steps REMOVED by a path predicate (step_unless_only only) — a real coverage reduction
SKIPPED_NAMES=""       # their names, for the attestation ("skipped by path predicate: pytest")
CHANGED_KNOWN=0        # 1 once compute_changed_files has a real --since baseline to diff against
_PRED_TAG=""           # shown by --list/--dry-run next to a predicated step; cleared after each
TIMEOUT_WARNED=0       # warn once if step_timeout is set but no timeout binary exists
LOCK_SCOPE="${PORTABLE_CI_LOCK:-repo}"          # repo | machine | off — `serialize` / --no-lock override
LOCK_TIMEOUT="${PORTABLE_CI_LOCK_TIMEOUT:-1800}" # seconds to wait for a busy lock before giving up
LOCK_HELD=""           # path of the lock dir we own (released on exit); empty = none
LOCK_CLI=0             # 1 once --no-lock is given: the flag beats any `serialize` in .localci
SHARD_INDEX=""         # `--shard I/K`: this run is shard I (0-based) of K ("" = unsharded)
SHARD_COUNT=""
SHARD_DIR=""           # where a sharded run's steps drop their evidence ($CI_SHARD_DIR)
SHARD_STARTED=""       # UTC stamp, run start
SHARD_TREE_CLEAN_START=""  # true|false: `git status --porcelain` empty before any step
RERUN_OF=""            # `--rerun-of SHA`: this run is a recorded re-run of that (current HEAD) sha
PREV_VERDICT=""        # verdict of the newest record for HEAD when this run started ("" = none)
PREV_RECORD=""         # path of that record
PREV_FLAKED_STEPS=""   # step names that failed in it (", "-joined)
PREV_FLAKED_TESTS=""   # failing test ids in it (newline-separated)
VERDICT=""             # passed | FAILED | passed-on-rerun — set by finalize_verdict
RECORD_PATH=""         # the run record this run wrote ("" = none written)
declare -a STEP_RECS=()  # one JSON object (single line) per step, for the run record
FAILED_IDS=""          # pytest-shaped `FAILED <nodeid>` ids from hard-failed steps (newline-separated)
declare -a RESULTS=()   # "ok|name" / "fail|name" / "soft-ok|name" / "soft-fail|name"

usage() {
  # Print the leading comment block (from line 2 until the first non-comment line).
  awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
}

# ---------- step implementations ----------
# `step NAME COMMAND...`      — a hard check; failure fails the run.
# `step_soft NAME COMMAND...` — an advisory check; failure is reported but never
#   gates the run or flips the published status to failure. Use it for
#   non-deterministic or informational checks (e.g. an LLM adversarial review)
#   that shouldn't block a merge.
step()      { _dispatch 0 "$@"; }
# shellcheck disable=SC2317  # invoked from sourced .localci configs, not directly here
step_soft() { _dispatch 1 "$@"; }

# ---------- path predicates (`step_unless_only` / `step_when_only`) ----------
# `step_unless_only GLOBS NAME COMMAND...` — a hard step that is SKIPPED when the
#   changed-file set is known, non-empty, and EVERY file matches one of the
#   space-separated GLOBS (bash `case` patterns; `*` crosses `/`, so `*.md`
#   matches `docs/a/b.md`). Otherwise it runs exactly like `step`.
# `step_when_only GLOBS NAME COMMAND...` — the complement: a hard step that runs
#   ONLY under that condition and is skipped otherwise.
#
# WHY: the recurring "CI is slow" case is a docs-only push paying for the whole
# test suite. The honest fix is not a faster runner but a smaller, still-real
# verdict: skip the suite, run the checks a docs change CAN break (ledger-drift
# guards, changelog coverage, a credential scan). Expressing that as data in
# .localci — rather than as bash pasted into a managed hook, which the next
# `install-hook` silently overwrites — is the whole point of these two lines.
#
# THE SAFE DIRECTION IS HARD-CODED. With NO scope (no --since, not a git repo)
# or an EMPTY diff, there is nothing to classify: unless_only steps RUN and
# when_only steps are SKIPPED, so an unscoped run is always the full run. A
# predicate can only ever remove work when it can see exactly what changed.
#
# TWO KINDS OF SKIP, AND ONLY ONE IS A REDUCTION. An unless_only step that is
# skipped REMOVES a check — coverage genuinely shrank — so it is counted and
# named in the summary, the published status description and the attestation
# ("· skipped by path predicate: pytest"). A when_only step that does not run
# is INERT: either there was no scope (its unless_only twin ran in full) or the
# diff was not within the globs (again, the twin ran). Counting those as
# "partial" would label every hosted-Actions run and every ordinary code push
# partial forever — the exact line consumers key merge authority on — and the
# skip count could no longer tell a docs-only push from a code push (both would
# read "1 skipped"). So inert skips are printed ("not run") but never counted.
# Pair every unless_only with a when_only that runs the reduced checks; a run in
# which every hard step was REMOVED fails rather than attesting a green 0/0.
#
# `ci doctor` ignores predicates (a tool is missing or not, regardless of the
# diff); `--list` / `--dry-run` show "would skip" using the same decision.
# shellcheck disable=SC2317  # invoked from sourced .localci configs, not directly here
step_unless_only() {
  local globs="$1"; shift
  if [ "$MODE" = "run" ] && _changed_all_match "$globs"; then
    _step_skip reduced "$1" "every changed file matches: $globs"; return 0
  fi
  _PRED_TAG="unless-only: $globs"; _dispatch 0 "$@"; _PRED_TAG=""
}
# shellcheck disable=SC2317  # invoked from sourced .localci configs, not directly here
step_when_only() {
  local globs="$1"; shift
  if [ "$MODE" = "run" ] && ! _changed_all_match "$globs"; then
    _step_skip inert "$1" "changed files unknown, or not all within: $globs"; return 0
  fi
  _PRED_TAG="when-only: $globs"; _dispatch 0 "$@"; _PRED_TAG=""
}

# True iff the changed-file set is KNOWN, NON-EMPTY, and every file matches one
# of the globs. Unknown or empty is false on purpose (see above).
_changed_all_match() {
  [ "$CHANGED_KNOWN" -eq 1 ] || return 1
  [ -n "${CI_CHANGED_FILES:-}" ] || return 1
  # Split the glob list into words with PATHNAME EXPANSION OFF. An unquoted
  # `for g in $1` would expand each word against the CWD before the loop ran, so
  # `*.md` became `README.md` whenever one existed at the top level — the
  # predicate then compared FILENAMES, not patterns: a nested `sub/deep.md` or a
  # docs-only DELETION silently failed to match and ran the full suite. Caught in
  # review; the first test set passed by filesystem accident (test 67 had a
  # top-level README.md, test 70 did not — opposite luck, both green).
  local f g matched _noglob_was_on=0
  local -a globs
  case $- in *f*) _noglob_was_on=1 ;; *) set -f ;; esac
  # shellcheck disable=SC2206  # split-only is the interface; globbing is OFF here
  globs=($1)
  [ "$_noglob_was_on" -eq 1 ] || set +f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    matched=0
    for g in "${globs[@]}"; do
      # shellcheck disable=SC2254  # $g must stay unquoted to act as a pattern
      case "$f" in $g) matched=1; break ;; esac
    done
    [ "$matched" -eq 1 ] || return 1
  done <<< "$CI_CHANGED_FILES"
  return 0
}

# `_step_skip reduced|inert NAME WHY` — see the directive comment for the two kinds.
_step_skip() {
  local kind="$1" name="$2" why="$3"
  local verb="skipped" future="skip"
  [ "$kind" = "inert" ] && { verb="not run"; future="not run"; }
  if [ "$SHOW_ONLY" = "list" ]; then
    printf '  %-16s %s(%s: %s)%s\n' "$name" "$C_DIM" "$verb" "$why" "$C_RESET"; return 0
  elif [ -n "$SHOW_ONLY" ]; then
    printf '%swould %s%s %s: %s\n' "$C_DIM" "$future" "$C_RESET" "$name" "$why"; return 0
  fi
  printf '%s↷ %s — %s (%s)%s\n\n' "$C_DIM" "$name" "$verb" "$why" "$C_RESET"
  if [ "$kind" = "reduced" ]; then
    RESULTS+=("skip|$name")
    SKIPPED=$((SKIPPED + 1))
    SKIPPED_NAMES="${SKIPPED_NAMES:+$SKIPPED_NAMES, }$name"
    _summary_row "$name" "skipped ($why)" 0
    _rec_skip "$name" "skipped"
  else
    RESULTS+=("inert|$name")
    _summary_row "$name" "not run ($why)" 0
    _rec_skip "$name" "not-run"
  fi
}

# `step_timeout N` — cap every step declared AFTER this line at N seconds. It is
# a plain setter (not a step), so a config can vary the cap between steps:
#   step_timeout 30 ; step "lint" ...    # 30s
#   step_timeout 300; step "test" ...    # 300s
# A step that exceeds the cap is killed and counts as a failure (advisory steps
# report it without gating). `step_timeout 0` clears the cap.
#
# HONEST LIMITS: (1) needs a `timeout` binary (coreutils `timeout`, or `gtimeout`
# on macOS); without one the cap is skipped with a single warning, never a silent
# no-op. (2) A capped step runs as an external process, so — unlike an uncapped
# step — it cannot call a shell function defined inside .localci. Wrap such a step
# in `bash -c '...'` if you need both.
# shellcheck disable=SC2317  # invoked from sourced .localci configs, not directly here
step_timeout() {
  local n="${1:-0}"
  case "$n" in
    ''|*[!0-9]*)
      printf '%sportable-ci:%s step_timeout needs a whole number of seconds, got %s\n' \
        "$C_BOLD" "$C_RESET" "$n" >&2
      exit 2 ;;
  esac
  STEP_TIMEOUT="$n"
}

# ---------- config version requirement (`min_version`) ----------
# `min_version X.Y.Z` at the top of a .localci declares the minimum portable-ci
# the config needs. Running an older `ci` stops with an actionable message
# instead of a cryptic one.
#
# WHY THIS EXISTS: a consumer wrote a `step_soft` config against an install that
# predated `step_soft`. The failure was `step_soft: command not found` — which
# names neither the cause nor the fix — and `ci --version` reported the same
# number as the version that HAS the feature (0.1.0 never moved; see CHANGELOG).
#
# HONEST LIMIT — read before assuming this fixes the class: an install older
# than THIS function will fail with `min_version: command not found`, because
# it has no way to know what the line means. `min_version` bounds the problem
# from here forward; it cannot reach back to installs that already exist. For a
# config that must diagnose itself on any install, use the portable guard idiom
# (works on 0.1.0, needs nothing from the tool):
#
#   if declare -F min_version >/dev/null 2>&1; then min_version 0.3.0
#   else echo "this .localci needs portable-ci >= 0.3.0 — run install.sh" >&2; exit 2; fi
#
# Exit 2, not 1: the run produced no verdict. That is "couldn't determine",
# matching `ci quota` and the missing-config path — never "your code failed".
min_version() {
  local want="${1:-}"
  # shellcheck disable=SC2016  # the backticks below are literal help text, not subshells
  case "$want" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    "") printf '%sportable-ci:%s min_version needs a version argument, e.g. `min_version 0.3.0`
'           "$C_BOLD" "$C_RESET" >&2; exit 2 ;;
    # A malformed requirement must FAIL, never silently pass. A config asking for
    # `min_version latest` that quietly succeeded would assert a guarantee it
    # never checked.
    *)  printf '%sportable-ci:%s min_version needs X.Y.Z, got %s
'           "$C_BOLD" "$C_RESET" "$want" >&2; exit 2 ;;
  esac
  _version_lt "$VERSION" "$want" || return 0
  printf '%sportable-ci:%s %s requires portable-ci >= %s — you are running %s.
'     "$C_BOLD" "$C_RESET" "$CONFIG" "$want" "$VERSION" >&2
  printf '  Update: curl -fsSL https://raw.githubusercontent.com/Munns729/portable-ci/v1/install.sh | bash
' >&2
  exit 2
}

# Is $1 strictly older than $2? Numeric per-field compare; a non-numeric suffix
# (0.3.0-rc1) is truncated to its leading digits rather than rejected, so a
# prerelease install still satisfies the release requirement it was cut from.
_version_lt() {
  [ "$1" = "$2" ] && return 1
  local a1 a2 a3 b1 b2 b3
  # Parse each side INDEPENDENTLY. An earlier version split both in one
  # `set -- $1 "|" $2` and read the right-hand fields from fixed positions —
  # which silently shifts when the left side has fewer than three fields, so
  # `1` vs `2.0.0` compared against the wrong operand. Caught by a comparison
  # table, not by the happy path: `2` vs `1.0.0` returned the RIGHT answer for
  # the WRONG reason and looked like a pass.
  IFS=. read -r a1 a2 a3 _ <<EOF
$1
EOF
  IFS=. read -r b1 b2 b3 _ <<EOF
$2
EOF
  # Truncate any non-numeric suffix (0.3.0-rc1 -> 0 3 0) so a prerelease still
  # satisfies the release it was cut from. Empty field -> 0.
  a1="${a1%%[!0-9]*}"; a2="${a2%%[!0-9]*}"; a3="${a3%%[!0-9]*}"
  b1="${b1%%[!0-9]*}"; b2="${b2%%[!0-9]*}"; b3="${b3%%[!0-9]*}"
  [ "${a1:-0}" -lt "${b1:-0}" ] && return 0
  [ "${a1:-0}" -gt "${b1:-0}" ] && return 1
  [ "${a2:-0}" -lt "${b2:-0}" ] && return 0
  [ "${a2:-0}" -gt "${b2:-0}" ] && return 1
  [ "${a3:-0}" -lt "${b3:-0}" ] && return 0
  return 1
}

# ---------- run lock ----------
# Two overlapping `ci run`s on one machine are the documented way a green suite
# turns red for no reason: (a) several pre-push hooks (one per concurrent
# session/worktree) each start a full suite and the box runs out of memory —
# the loser aborts mid-run with exit 1 and NO failed test named; (b) a suite
# reads a working tree that another run is rewriting underneath it (the 6.5-min
# delete-only-push failure noted in the pre-push hook). Neither is a check
# failing; both teach `--no-verify`. So `ci run` takes a lock before its first
# step and later callers WAIT, visibly, instead of competing.
#
# Scope (`serialize` in .localci, PORTABLE_CI_LOCK, or --no-lock):
#   repo     — one run per repository, shared across all of its worktrees
#              (keyed on the git common dir, so a worktree and its main checkout
#              contend for the same lock). Default.
#   machine  — one run per machine, any repository. For boxes where the suite
#              is the resource, not the tree (one 16GB box, three pytest suites).
#   off      — no lock.
# GitHub Actions runs are never locked: the hosted runner is already one job on
# one fresh VM, and `concurrency:` groups serialise at the workflow level.
#
# Mechanism: an atomic `mkdir` (works on Linux, macOS, and Git Bash on Windows —
# `flock` does not) under $PORTABLE_CI_LOCK_DIR, else $XDG_RUNTIME_DIR, else
# $TMPDIR, else /tmp. The holder records its PID, directory, and start time so a
# waiter can say WHO it is waiting on. A lock whose holder PID is gone is stale
# (a crashed or killed run) and is reclaimed, never waited on. Reclaiming is
# itself serialised behind a second mkdir mutex, so two waiters that both see
# the dead PID can't race each other (one would delete the other's fresh lock).
#
# Known limit: liveness is `kill -0`. A recycled PID reads as alive, so a lock
# whose holder died and whose PID was reused waits out the full timeout before
# exit 3 — which at least names the holder and the fix (--no-lock). Likewise a
# holder that dies between `mkdir` and writing its pid leaves a pid-less dir;
# waiters treat that as mid-acquire for a few polls, then as stale.
_lock_root() {
  local base="${PORTABLE_CI_LOCK_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}}"
  printf '%s/portable-ci-locks' "${base%/}"
}

# Identity of the thing we're serialising on. Hashed so a path is a safe dir
# name on every platform (drive letters, spaces, slashes).
_lock_key() {
  local id
  case "$LOCK_SCOPE" in
    machine) id="machine" ;;
    *) id="$(git rev-parse --git-common-dir 2>/dev/null || pwd)"
       # `--git-common-dir` is RELATIVE to the cwd on git < 2.31 (no
       # --path-format), typically just `.git` — which would hash identically
       # for every repo and silently serialise unrelated ones. Resolve it to an
       # absolute, symlink-free path before hashing.
       id="$(cd "$id" 2>/dev/null && pwd -P || printf '%s' "$id")" ;;
  esac
  printf '%s' "$id" | cksum | awk '{print $1}'
}

_pid_alive() { kill -0 "$1" 2>/dev/null; }

_lock_release() {
  [ -n "$LOCK_HELD" ] || return 0
  rm -rf "$LOCK_HELD"
  LOCK_HELD=""
}

# Acquire the run lock, or wait for it. Called once, lazily, by _dispatch before
# the first step runs — so `serialize` can appear anywhere above the steps, and
# --list / --dry-run / doctor (which dispatch but never run) never take it.
_lock_acquire() {
  [ -n "$LOCK_HELD" ] && return 0
  [ "$LOCK_SCOPE" = "off" ] && return 0
  in_github_actions && return 0
  case "$LOCK_SCOPE" in repo|machine) ;; *)
    echo "portable-ci: serialize: expected repo|machine|off, got '$LOCK_SCOPE'" >&2; exit 2 ;;
  esac
  local root lock waited=0 announced=0 nopid=0 mtxwait=0 hpid hwhere hsince
  root="$(_lock_root)"
  mkdir -p "$root" 2>/dev/null || {
    echo "portable-ci: cannot create lock dir $root — running unlocked" >&2; return 0; }
  lock="$root/$(_lock_key).lock"
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      LOCK_HELD="$lock"
      printf '%s\n' "$$" > "$lock/pid"
      pwd > "$lock/where"
      date '+%Y-%m-%d %H:%M:%S' > "$lock/since"
      trap '_lock_release' EXIT
      trap '_lock_release; trap - INT; kill -INT $$' INT
      trap '_lock_release; trap - TERM; kill -TERM $$' TERM
      [ "$announced" -eq 1 ] && printf '%sportable-ci: lock acquired after %ss%s\n' "$C_DIM" "$waited" "$C_RESET" >&2
      return 0
    fi
    # mkdir failed. Contention is "the dir exists"; anything else (EACCES on a
    # shared /tmp root owned by another user, ENOSPC, read-only fs) is an error,
    # and waiting the full timeout on an error would disguise it as a busy lock.
    if [ ! -d "$lock" ]; then
      echo "portable-ci: cannot create lock $lock — running unlocked" >&2; return 0
    fi
    hpid="$(cat "$lock/pid" 2>/dev/null)"; hwhere="$(cat "$lock/where" 2>/dev/null)"; hsince="$(cat "$lock/since" 2>/dev/null)"
    # The timeout is checked FIRST, on every path through a failed mkdir — a
    # waiter that is stuck reclaiming (or stuck behind a wedged reclaim mutex)
    # must still end in exit 3 with a message, never an unbounded hang under a
    # developer's `git push`.
    if [ "$waited" -ge "$LOCK_TIMEOUT" ]; then
      printf '%sportable-ci: gave up waiting for the %s run lock after %ss (held by pid %s in %s since %s)%s\n' \
        "$C_RED" "$LOCK_SCOPE" "$waited" "${hpid:-?}" "${hwhere:-?}" "${hsince:-?}" "$C_RESET" >&2
      echo "portable-ci: pass --no-lock to run anyway, or PORTABLE_CI_LOCK_TIMEOUT=N to wait longer" >&2
      exit 3
    fi
    # Stale: the recorded holder PID no longer exists — or no PID was ever
    # recorded and that has persisted across several polls (a holder that died
    # between mkdir and writing its pid; a live one writes it within
    # milliseconds). Reclaim.
    if [ -z "$hpid" ]; then nopid=$((nopid + 1)); else nopid=0; fi
    if { [ -n "$hpid" ] && ! _pid_alive "$hpid"; } || [ "$nopid" -ge 5 ]; then
      # Reclaiming is serialised behind its own mutex. Without it, two waiters
      # that both observed the dead PID race: one reclaims and re-acquires, and
      # the other then deletes that fresh, LIVE lock — two runs proceed at once,
      # which is the exact failure this lock exists to prevent. Only the mutex
      # winner touches the lock dir; losers just loop and re-read.
      local mtx="$lock.reclaiming"
      if mkdir "$mtx" 2>/dev/null; then
        printf '%s\n' "$$" > "$mtx/pid"
        # Re-check under the mutex: the dir at $lock may have changed hands
        # since we read it. Delete only if it is STILL stale. An EMPTY pid here
        # is ambiguous — a dead mid-acquire holder, or a live one that took the
        # lock a moment ago and hasn't written its pid yet (a previous mutex
        # winner reclaiming and re-acquiring looks exactly like this). Give it
        # one full poll to fill in before calling it stale; a live holder writes
        # its pid within milliseconds of mkdir. (Observed without this: 1 in 5
        # four-way trials ran two suites at once.)
        hpid="$(cat "$lock/pid" 2>/dev/null)"
        if [ -z "$hpid" ] && [ -d "$lock" ]; then sleep 1; hpid="$(cat "$lock/pid" 2>/dev/null)"; fi
        if [ -d "$lock" ] && { [ -z "$hpid" ] || ! _pid_alive "$hpid"; }; then
          printf '%sportable-ci: reclaiming stale lock (pid %s, %s, gone)%s\n' "$C_DIM" "${hpid:-?}" "${hwhere:-?}" "$C_RESET" >&2
          rm -rf "$lock"
        fi
        rm -rf "$mtx"
        nopid=0; mtxwait=0
        continue
      fi
      # Someone else is reclaiming. A reclaimer that died mid-way would wedge
      # everyone, so the mutex gets the same stale-out as the lock: cleared if
      # its recorded holder is dead, or if it has stayed pid-less across several
      # polls (a live winner writes its pid within ms; the whole reclaim takes
      # ~2s, far under the 5-poll bound).
      #
      # Residual, stated honestly: this cleanup is itself a read-then-delete,
      # so two losers can both decide the mutex is dead and the slower `rm` can
      # remove a THIRD waiter's fresh mutex — two reclaimers at once. The harm
      # is bounded: under the mutex each reclaimer re-reads the lock's pid and
      # only deletes it if dead or still empty after a full poll, so a
      # re-acquired live lock survives unless its holder takes >1s to write a
      # pid. Serialising THIS cleanup would need a third mutex with the same
      # problem — it regresses forever; we stop at a bound, not a proof.
      local mpid; mpid="$(cat "$mtx/pid" 2>/dev/null)"
      if [ -z "$mpid" ]; then mtxwait=$((mtxwait + 1)); else mtxwait=0; fi
      if { [ -n "$mpid" ] && ! _pid_alive "$mpid"; } || [ "$mtxwait" -ge 5 ]; then
        rm -rf "$mtx"; mtxwait=0
      fi
      sleep 1; waited=$((waited + 1)); continue
    fi
    if [ "$announced" -eq 0 ]; then
      printf '%sportable-ci: another ci run holds the %s lock (pid %s in %s since %s) — waiting, not competing%s\n' \
        "$C_DIM" "$LOCK_SCOPE" "${hpid:-?}" "${hwhere:-?}" "${hsince:-?}" "$C_RESET" >&2
      announced=1
    fi
    sleep 1; waited=$((waited + 1))
  done
}

# .localci directive: `serialize repo|machine|off [TIMEOUT_SECONDS]`
serialize() {
  [ "$LOCK_CLI" -eq 1 ] && return 0   # the operator's --no-lock wins over the file
  if [ -n "$LOCK_HELD" ]; then
    echo "portable-ci: serialize must come before the first step (lock already taken)" >&2; exit 2
  fi
  LOCK_SCOPE="${1:-repo}"
  [ -n "${2:-}" ] && LOCK_TIMEOUT="$2"
  return 0
}

_dispatch() {
  local advisory="$1"; shift
  # `ci run --list` / `--dry-run` show the plan without executing anything.
  if [ -n "$SHOW_ONLY" ] && [ "$MODE" = "run" ]; then _step_show "$advisory" "$@"; return; fi
  case "$MODE" in
    run)    _lock_acquire; _step_run "$advisory" "$@" ;;
    doctor) _step_doctor "$advisory" "$@" ;;
  esac
}

# Print a step instead of running it (--list / --dry-run). No command is
# executed, so a dry run has no side effects and always exits 0.
_step_show() {
  local advisory="$1" name="$2"; shift 2
  local tag=""; [ "$advisory" = "1" ] && tag=" (advisory)"
  [ -n "$_PRED_TAG" ] && tag="$tag [$_PRED_TAG]"
  local cap=""; [ "${STEP_TIMEOUT:-0}" -gt 0 ] && cap=" ${C_DIM}[${STEP_TIMEOUT}s]${C_RESET}"
  if [ "$SHOW_ONLY" = "list" ]; then
    printf '  %-16s%s %s%s%s\n' "$name" "$tag" "$C_DIM" "$*" "$C_RESET$cap"
  else
    printf '%swould run%s %s%s%s: %s\n' "$C_BOLD" "$C_RESET" "$name" "$tag" "$cap" "$*"
  fi
}

# Which timeout binary to use for step_timeout, if any: coreutils `timeout`, or
# `gtimeout` (coreutils under a prefixed name, common on macOS). Echoes empty if
# neither is installed.
_timeout_bin() {
  if command -v timeout  >/dev/null 2>&1; then printf 'timeout'
  elif command -v gtimeout >/dev/null 2>&1; then printf 'gtimeout'; fi
}

# Run a step's command, wrapped in `timeout` when step_timeout is active. A
# timed-out command exits 124 (timeout's convention), which the caller renders
# as "timed out" rather than a bare exit code.
_run_step_cmd() {
  if [ "${STEP_TIMEOUT:-0}" -gt 0 ]; then
    local tbin; tbin="$(_timeout_bin)"
    if [ -n "$tbin" ]; then "$tbin" "$STEP_TIMEOUT" "$@"; return $?; fi
  fi
  "$@"
}

# The "no timeout binary" warning, once per run. It is raised from _step_run, not
# _run_step_cmd, because the latter runs on the left of a pipe (a subshell) where
# setting TIMEOUT_WARNED would not stick and every step would warn again.
_timeout_warn_once() {
  [ "${STEP_TIMEOUT:-0}" -gt 0 ] || return 0
  [ -z "$(_timeout_bin)" ] || return 0
  [ "$TIMEOUT_WARNED" -eq 0 ] || return 0
  # shellcheck disable=SC2016  # backticks are literal hint text, not substitution
  printf '%s  ↳ step_timeout set but no `timeout` binary found — running without a limit%s\n' \
    "$C_DIM" "$C_RESET" >&2
  TIMEOUT_WARNED=1
}

# Emit a GitHub Actions workflow command — but ONLY inside a real Actions job, so
# local runs never leak `::...::` lines into their output. Used to wrap each
# step's output in a collapsible log group and to raise an inline error/warning
# annotation on failure, so a red step shows up in the Actions UI and the PR
# checks tab, not just buried in the run log. Workflow commands must each be an
# unprefixed line on their own — keep them uncolored.
_gha() { in_github_actions || return 0; printf '%s\n' "$*"; }

_step_run() {
  local advisory="$1" name="$2"; shift 2
  local tag=""; [ "$advisory" = "1" ] && tag=" $C_DIM(advisory)$C_RESET"
  printf '%s▶ %s%s%s\n' "$C_BOLD" "$name" "$C_RESET" "$tag"
  _gha "::group::$name"
  _timeout_warn_once
  # The step's output is teed to a temp file so a FAILED step's tail can go in
  # the run record. If no temp file can be made the step simply runs uncaptured:
  # recording never decides whether a step runs or what it returns. The pipe puts
  # the command in a subshell, so (as with any `cmd | tee`) a shell function in
  # .localci that sets variables for later steps no longer does so.
  local cap rc; cap="$(mktemp 2>/dev/null)" || cap=""
  local start="$SECONDS"
  if [ -n "$cap" ]; then
    _run_step_cmd "$@" 2>&1 | tee "$cap"; rc="${PIPESTATUS[0]}"
  else
    _run_step_cmd "$@"; rc=$?
  fi
  local dur=$((SECONDS - start))
  if [ "$rc" -eq 0 ]; then
    _gha "::endgroup::"
    printf '%s✓ %s%s %s(%ss)%s\n\n' "$C_GREEN" "$name" "$C_RESET" "$C_DIM" "$dur" "$C_RESET"
    RESULTS+=("$([ "$advisory" = "1" ] && echo soft-ok || echo ok)|$name")
    _summary_row "$name" "pass" "$dur"
    _rec_step "$name" "$([ "$advisory" = "1" ] && echo advisory-pass || echo pass)" 0 "$dur" ""
  else
    _gha "::endgroup::"
    # 124 is `timeout`'s exit when it kills a step_timeout-capped command.
    local why="exit $rc"; [ "$rc" -eq 124 ] && [ "${STEP_TIMEOUT:-0}" -gt 0 ] && why="timed out after ${STEP_TIMEOUT}s"
    if [ "$advisory" = "1" ]; then
      # Advisory: surface it clearly, but do NOT set FAIL or touch the exit code.
      _gha "::warning title=portable-ci::advisory step '$name' failed ($why)"
      printf '%s⚠ %s — advisory (%s, %ss), not blocking%s\n\n' "$C_DIM" "$name" "$why" "$dur" "$C_RESET"
      RESULTS+=("soft-fail|$name")
      ADVISORY_FAIL=$((ADVISORY_FAIL + 1))
      _summary_row "$name" "advisory finding ($why)" "$dur"
      _rec_step "$name" "advisory-fail" "$rc" "$dur" "$cap"
    else
      _gha "::error title=portable-ci::step '$name' failed ($why)"
      printf '%s✗ %s (%s, %ss)%s\n\n' "$C_RED" "$name" "$why" "$dur" "$C_RESET"
      RESULTS+=("fail|$name")
      FAIL=1
      _summary_row "$name" "FAIL ($why)" "$dur"
      _rec_step "$name" "FAIL" "$rc" "$dur" "$cap"
    fi
  fi
  if [ -n "$cap" ] && [ -n "$SHARD_DIR" ]; then
    cp "$cap" "$SHARD_DIR/step-$(_shard_safe_name "$name").out" 2>/dev/null || true
  fi
  [ -z "$cap" ] || rm -f "$cap"
}

# Tools that must import your project's dependencies to work (type-checkers,
# test runners, coverage). For these, the interpreter their launcher runs under
# has to be the one your deps are installed in — see _interpreter_note.
_INTERP_SENSITIVE=" mypy pytest pyright coverage tox nox pylint "

# Warn when a resolved tool's launcher runs under a different Python than the
# `python3` on PATH. That's the "bare mypy vs python -m mypy" split: the console
# script uses the interpreter baked into its shebang, which may not be the one
# your project's dependencies live in — so it fails cryptically at run time, not
# here. Only checked for interpreter-sensitive tools, and only a hint (never
# fails doctor).
_interpreter_note() {
  case "$_INTERP_SENSITIVE" in *" $1 "*) ;; *) return 0 ;; esac
  local toolpath shebang shpy pathpy a b
  toolpath="$(command -v "$1" 2>/dev/null)" || return 0
  shebang="$(head -c 256 "$toolpath" 2>/dev/null | head -n1)"
  case "$shebang" in \#!*python*) ;; *) return 0 ;; esac
  shpy="${shebang#\#!}"; shpy="${shpy%% *}"           # first token after #!
  case "$shpy" in */env) return 0 ;; esac             # `env python` follows PATH — no split
  pathpy="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
  [ -n "$pathpy" ] || return 0
  a="$(readlink -f "$shpy" 2>/dev/null || printf '%s' "$shpy")"
  b="$(readlink -f "$pathpy" 2>/dev/null || printf '%s' "$pathpy")"
  [ "$a" = "$b" ] && return 0
  # shellcheck disable=SC2016  # backticks are literal hint text, not substitution
  printf '    %s↳ runs under %s, but your python3 is %s — if deps live in the latter, use `python -m %s`%s\n' \
    "$C_DIM" "$shpy" "$pathpy" "$1" "$C_RESET"
}

# Doctor: check that each step's underlying executable is installed. A missing
# tool for an advisory step is reported as optional and does not fail doctor.
_step_doctor() {
  local advisory="$1" name="$2"; shift 2
  local tool="${1:-}"
  # Unwrap `bash -c` / `sh -c` wrappers to probe the real first word.
  if { [ "$tool" = "bash" ] || [ "$tool" = "sh" ]; } && [ "${2:-}" = "-c" ]; then
    tool="$(printf '%s\n' "$3" | awk '{print $1}')"
  fi
  if command -v "$tool" >/dev/null 2>&1; then
    local ver; ver="$("$tool" --version 2>/dev/null | head -1)"
    printf '  %s✓%s %-16s %s%s%s\n' "$C_GREEN" "$C_RESET" "$name" "$C_DIM" "${ver:-$tool present}" "$C_RESET"
    _interpreter_note "$tool"
  elif [ "$advisory" = "1" ]; then
    printf '  %s○%s %-16s %soptional, missing: %s%s\n' "$C_DIM" "$C_RESET" "$name" "$C_DIM" "$tool" "$C_RESET"
  else
    printf '  %s✗%s %-16s %smissing: %s%s\n' "$C_RED" "$C_RESET" "$name" "$C_DIM" "$tool" "$C_RESET"
    MISSING=$((MISSING + 1))
  fi
}

_summary_row() {
  [ -n "${GITHUB_STEP_SUMMARY:-}" ] || return 0
  printf '| %s | %s | %ss |\n' "$1" "$2" "$3" >> "$GITHUB_STEP_SUMMARY"
}

# ---------- auto-detection (used when no .localci is present) ----------
autodetect() {
  if [ -f pyproject.toml ] || [ -f setup.py ] || ls ./*.py >/dev/null 2>&1; then
    command -v ruff   >/dev/null 2>&1 && step "ruff"   ruff check .
    command -v mypy   >/dev/null 2>&1 && step "mypy"   mypy .
    command -v pytest >/dev/null 2>&1 && step "pytest" pytest -q
  fi
  if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
    local s
    for s in lint typecheck test; do
      if node -e "process.exit((require('./package.json').scripts||{})['$s']?0:1)" 2>/dev/null; then
        step "npm $s" npm run "$s" --silent
      fi
    done
  fi
  if [ "${#RESULTS[@]}" -eq 0 ] && [ "$MISSING" -eq 0 ] && [ "$MODE" = "run" ]; then
    printf '%sportable-ci:%s no %s file and nothing auto-detected.\n' "$C_BOLD" "$C_RESET" "$CONFIG" >&2
    # shellcheck disable=SC2016  # backticks are literal hint text, not substitution
    printf 'Run `ci init` to scaffold one, or add a %s file by hand (see `ci --help`).\n' "$CONFIG" >&2
    exit 2
  fi
}

load_steps() {
  if [ -f "$CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG"
  elif [ "$CONFIG_EXPLICIT" = "1" ]; then
    # An explicit --config / PORTABLE_CI_CONFIG that doesn't exist is an error,
    # never a silent fall-through to autodetect — otherwise a typo'd path runs a
    # different set of checks than the caller asked for (and can read as a pass).
    printf '%sportable-ci:%s config file not found: %s\n' "$C_BOLD" "$C_RESET" "$CONFIG" >&2
    exit 2
  else
    autodetect
  fi
}

# ---------- changed-files scoping ----------
compute_changed_files() {
  [ -n "$SINCE" ] || return 0
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "portable-ci: --since given but not in a git repo" >&2; return 0
  fi
  if CI_CHANGED_FILES="$(git diff --name-only "$SINCE" -- 2>/dev/null)"; then
    CHANGED_KNOWN=1   # a real baseline exists; an EMPTY list still means "nothing to classify"
  else
    # A bad --since ref must not become "known and empty": that would run
    # unless_only steps (fine) but silently skip every when_only step.
    CI_CHANGED_FILES=""
    printf '%sportable-ci:%s --since %s did not resolve — running UNSCOPED\n' "$C_BOLD" "$C_RESET" "$SINCE" >&2
  fi
  export CI_CHANGED_FILES
  local n; n="$(printf '%s' "$CI_CHANGED_FILES" | grep -c . || true)"
  # shellcheck disable=SC2016  # $CI_CHANGED_FILES is printed literally, on purpose.
  printf '%s%s file(s) changed since %s — exported as $CI_CHANGED_FILES%s\n\n' \
    "$C_DIM" "$n" "$SINCE" "$C_RESET"
}

# ---------- repo resolution ----------
# Echo "owner/repo" for status publishing, or nothing if it can't be determined.
# Honours $REPO (PORTABLE_CI_REPO / --repo) first, then parses a github.com remote.
# Non-github.com remotes (proxied checkouts, GHE) can't be parsed generically —
# that's what the override is for.
resolve_repo() {
  if [ -n "$REPO" ]; then printf '%s\n' "$REPO"; return 0; fi
  local remote
  remote="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$remote" ] || return 0
  printf '%s' "$remote" \
    | sed -E 's#^(git@github.com:|https://github.com/|ssh://git@github.com/)##; s#\.git$##' \
    | grep -E '^[^/]+/[^/]+$' || true
}

# ---------- provenance helpers ----------
# True inside a GitHub Actions job — a run there is "hosted", not a local backup.
in_github_actions() { [ "${GITHUB_ACTIONS:-}" = "true" ]; }

# The commit-status context to publish under. An explicit --context /
# PORTABLE_CI_CONTEXT always wins. Otherwise default so a local backup can never
# wear the same name as a hosted run: `portable-ci` in Actions, `portable-ci/local`
# when run from a developer's machine.
effective_context() {
  if [ -n "$STATUS_CONTEXT" ]; then printf '%s\n' "$STATUS_CONTEXT"; return 0; fi
  if in_github_actions; then printf 'portable-ci\n'; else printf 'portable-ci/local\n'; fi
}

# A description that can't overstate the run: says whether it was hosted or a
# local backup, how many checks ran, and whether it was scoped to changed files
# (i.e. partial). GitHub truncates statuses at 140 chars; this stays well under.
status_description() {
  local passed=0 failed=0 soft_fail=0 r
  for r in "${RESULTS[@]:-}"; do
    [ -n "$r" ] || continue
    case "${r%%|*}" in
      ok)        passed=$((passed + 1)) ;;
      fail)      failed=$((failed + 1)) ;;
      soft-ok)   passed=$((passed + 1)) ;;
      soft-fail) soft_fail=$((soft_fail + 1)) ;;
      skip|inert) ;;  # skip counted via $SKIPPED; inert never counts — neither is a pass or a fail
    esac
  done
  local total=$((passed + failed)) origin desc
  if in_github_actions; then origin="hosted"; else origin="local backup"; fi
  if [ "$failed" -gt 0 ]; then
    desc="$origin · $passed/$total passed, $failed failed"
  else
    desc="$origin · $total/$total checks passed"
  fi
  # Advisory findings update the description but never the pass/fail state.
  [ "$soft_fail" -gt 0 ] && desc="$desc · $soft_fail advisory finding(s)"
  [ "$SKIPPED" -gt 0 ] && desc="$desc · skipped by path predicate: $SKIPPED_NAMES (partial)"
  [ -n "$SINCE" ] && desc="$desc · scoped to $SINCE (partial)"
  [ "$VERDICT" = "passed-on-rerun" ] && desc="$desc · passed on re-run after a failure"
  printf '%s' "$desc"
}

# ---------- durable run record ----------
# Hosted CI artefacts expire; what survives is a status. A run record is the
# local counterpart that does NOT expire with the terminal scrollback: one JSON
# file per `ci run` at
#   ${PORTABLE_CI_RUNS_DIR:-$HOME/.portable-ci/runs}/<repo-slug>/<full-sha>/<UTC-stamp>.json
# holding the sha, branch, scope, platform, portable-ci version, each step's
# status / exit code / duration, and for a FAILED step the last 40 lines of its
# output plus any pytest-shaped `FAILED <nodeid>` lines. Failing to write it only
# warns on stderr — it never changes the verdict or the exit code.
#
# The layout is line-oriented on purpose (one step per line, one failing test id
# per line) so `--rerun-of` can read a record back with grep/sed, no jq needed.
RECORD_TAIL_LINES=40

# Quote $1 as a JSON string: strip ANSI colour codes and control characters, escape
# backslash/quote/tab, and join lines with \n.
_json_str() {
  printf '%s' "$1" | sed "s/$(printf '\033')\[[0-9;]*[A-Za-z]//g" | awk '
    BEGIN { printf "\"" }
    { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "");
      gsub(/[\001-\010\013\014\016-\037]/, "");
      if (NR > 1) printf "\\n"; printf "%s", $0 }
    END { printf "\"" }'
}

# Reverse of _json_str for the two escapes it emits that matter in a name or id.
_json_unstr() { sed 's/\\"/"/g; s/\\\\/\\/g'; }

# Append a step object to STEP_RECS. $5 is the step's captured-output file; it is
# read only for a hard or advisory FAILURE.
_rec_step() {
  local name="$1" status="$2" rc="$3" dur="$4" cap="${5:-}"
  local tail="" ids="" idjson="" id
  case "$status" in
    FAIL|advisory-fail)
      if [ -n "$cap" ] && [ -f "$cap" ]; then
        tail="$(tail -n "$RECORD_TAIL_LINES" "$cap" 2>/dev/null || true)"
        ids="$(sed "s/$(printf '\033')\[[0-9;]*[A-Za-z]//g" "$cap" 2>/dev/null \
          | sed -n 's/^FAILED \([^ ][^ ]*\).*/\1/p' | awk '!seen[$0]++')"
      fi ;;
  esac
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    idjson="${idjson:+$idjson,}$(_json_str "$id")"
  done <<EOF_IDS
$ids
EOF_IDS
  if [ "$status" = "FAIL" ] && [ -n "$ids" ]; then
    FAILED_IDS="${FAILED_IDS:+$FAILED_IDS
}$ids"
  fi
  STEP_RECS+=("{\"name\": $(_json_str "$name"), \"status\": \"$status\", \"exit_code\": $rc, \"duration_s\": $dur, \"failed_tests\": [$idjson], \"tail\": $(_json_str "$tail")}")
}

# Record a step that did not run (path predicate), so the record matches the summary.
_rec_skip() { STEP_RECS+=("{\"name\": $(_json_str "$1"), \"status\": \"$2\", \"exit_code\": 0, \"duration_s\": 0, \"failed_tests\": [], \"tail\": \"\"}"); }

_runs_root() { printf '%s' "${PORTABLE_CI_RUNS_DIR:-${HOME:-.}/.portable-ci/runs}"; }

# Filesystem-safe repo slug: owner-repo from the remote, else the top-level dir name.
_repo_slug() {
  local r; r="$(resolve_repo)"
  [ -n "$r" ] || r="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
  printf '%s' "$r" | tr -c 'A-Za-z0-9._\n-' '-' | sed 's/^[-.]*//; s/[-.]*$//' | cut -c1-80
}

# The directory holding the records for the commit being verified.
_record_dir() {
  local sha slug; sha="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  [ -n "$sha" ] || sha="no-commit"
  slug="$(_repo_slug)"; [ -n "$slug" ] || slug="repo"
  # A shard's records live apart: shard 1 failing must never make shard 2's pass "on-rerun".
  [ -n "$SHARD_COUNT" ] && sha="$sha/shard-$SHARD_INDEX-of-$SHARD_COUNT"
  printf '%s/%s/%s' "$(_runs_root)" "$slug" "$sha"
}

# Load the newest record for HEAD into PREV_* (so a rerun / a bare run can say what
# happened last time). Called BEFORE this run writes its own record.
_load_previous_record() {
  PREV_VERDICT=""; PREV_RECORD=""; PREV_FLAKED_STEPS=""; PREV_FLAKED_TESTS=""
  local dir newest; dir="$(_record_dir)"
  [ -d "$dir" ] || return 0
  # Newest = latest UTC stamp, then highest numeric `_N` collision suffix. Not glob
  # order: `_10` would sort before `_2`, and locale collation can reorder punctuation.
  newest="$(cd "$dir" 2>/dev/null && for f in *.json; do [ -f "$f" ] && printf '%s\n' "$f"; done \
    | LC_ALL=C awk '{ b = $0; sub(/\.json$/, "", b); n = 0
        if (match(b, /_[0-9]+$/)) { n = substr(b, RSTART + 1) + 0; b = substr(b, 1, RSTART - 1) }
        k = sprintf("%s%09d", b, n); if (k > best) { best = k; file = $0 } }
      END { print file }')"
  [ -n "$newest" ] || return 0
  PREV_RECORD="$dir/$newest"
  PREV_VERDICT="$(sed -n 's/^  "verdict": "\([^"]*\)".*/\1/p' "$PREV_RECORD" | head -1)"
  PREV_FLAKED_STEPS="$(grep '^    {"name": .*"status": "FAIL"' "$PREV_RECORD" \
    | sed 's/^    {"name": "\(.*\)", "status": "FAIL".*/\1/' | _json_unstr | paste -sd, - | sed 's/,/, /g')"
  PREV_FLAKED_TESTS="$(awk '/^  "failed_tests": \[/{f=1; next} f && /^  \]/{f=0} f' "$PREV_RECORD" \
    | sed 's/^    "//; s/",\{0,1\}$//' | _json_unstr)"
  # A record that is itself a passed-on-rerun carries the earlier failure forward,
  # so a third run cannot launder it back into a plain `passed`.
  if [ "$PREV_VERDICT" = "passed-on-rerun" ]; then
    local fs
    fs="$(sed -n 's/^  "flaked_steps": "\(.*\)",\{0,1\}$/\1/p' "$PREV_RECORD" | head -1 | _json_unstr)"
    PREV_FLAKED_STEPS="$fs"
    PREV_FLAKED_TESTS="$(awk '/^  "flaked_tests": \[/{f=1; next} f && /^  \]/{f=0} f' "$PREV_RECORD" \
      | sed 's/^    "//; s/",\{0,1\}$//' | _json_unstr)"
  fi
}

# Decide the verdict word. `passed-on-rerun` is a WEAKER verdict than `passed`: the
# same commit failed before and only went green on a re-run. Any run (with or
# without --rerun-of) at a sha whose newest record is FAILED / passed-on-rerun
# yields it; plain `passed` only when no failed record exists for the sha.
finalize_verdict() {
  VERDICT="passed"
  [ "$FAIL" -ne 0 ] && { VERDICT="FAILED"; return 0; }
  case "$PREV_VERDICT" in
    FAILED|passed-on-rerun) VERDICT="passed-on-rerun" ;;
  esac
}

# Write this run's record; set RECORD_PATH on success. Every failure path is a
# stderr warning and a return 0.
write_run_record() {
  RECORD_PATH=""
  local dir; dir="$(_record_dir)"
  # The record holds step output verbatim, which may include a secret a step
  # echoed. Output used to vanish with the terminal; keep it private to the user.
  local old_umask; old_umask="$(umask)"; umask 077
  if ! mkdir -p "$dir" 2>/dev/null || [ ! -w "$dir" ]; then
    umask "$old_umask"
    printf 'portable-ci: warning: could not write the run record under %s (verdict unchanged)\n' "$dir" >&2
    return 0
  fi
  local stamp file n=1
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  file="$dir/$stamp.json"
  while [ -e "$file" ]; do n=$((n + 1)); file="$dir/${stamp}_$n.json"; done
  local sha branch plat scope
  sha="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  plat="$(uname -srm 2>/dev/null || echo unknown)"
  scope="full"; [ -n "$SINCE" ] && scope="since $SINCE"
  local dirty=false
  [ -n "$(git status --porcelain 2>/dev/null | head -1)" ] && dirty=true
  local tmp="$file.tmp$$" i id ids_sep=""
  {
    printf '{\n'
    printf '  "schema": 1,\n'
    printf '  "portable_ci_version": %s,\n' "$(_json_str "$VERSION")"
    printf '  "verdict": "%s",\n' "$VERDICT"
    printf '  "sha": %s,\n' "$(_json_str "$sha")"
    printf '  "branch": %s,\n' "$(_json_str "$branch")"
    printf '  "scope": %s,\n' "$(_json_str "$scope")"
    printf '  "dirty": %s,\n' "$dirty"
    printf '  "platform": %s,\n' "$(_json_str "$plat")"
    printf '  "finished_utc": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "rerun_of": %s,\n' "$([ -n "$RERUN_OF" ] && _json_str "$RERUN_OF" || echo null)"
    if [ "$VERDICT" = "passed-on-rerun" ]; then
      printf '  "flaked_steps": %s,\n' "$(_json_str "$PREV_FLAKED_STEPS")"
      printf '  "flaked_tests": [\n'
      ids_sep=""
      while IFS= read -r id; do
        [ -n "$id" ] || continue
        printf '%s    %s' "$ids_sep" "$(_json_str "$id")"; ids_sep=$',\n'
      done <<EOF_FT
$PREV_FLAKED_TESTS
EOF_FT
      printf '\n  ],\n'
    fi
    printf '  "failed_tests": [\n'
    ids_sep=""
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      printf '%s    %s' "$ids_sep" "$(_json_str "$id")"; ids_sep=$',\n'
    done <<EOF_FI
$FAILED_IDS
EOF_FI
    printf '\n  ],\n'
    printf '  "steps": [\n'
    for i in "${!STEP_RECS[@]}"; do
      printf '    %s' "${STEP_RECS[i]}"
      [ "$i" -lt $((${#STEP_RECS[@]} - 1)) ] && printf ','
      printf '\n'
    done
    printf '  ]\n}\n'
  } > "$tmp" 2>/dev/null && mv "$tmp" "$file" 2>/dev/null
  umask "$old_umask"
  if [ -f "$file" ]; then
    RECORD_PATH="$file"
  else
    rm -f "$tmp" 2>/dev/null
    printf 'portable-ci: warning: could not write the run record %s (verdict unchanged)\n' "$file" >&2
  fi
  return 0
}

# Join the first 5 lines of $1 with ", " and note how many more there were.
_ids_summary() {
  printf '%s\n' "$1" | awk 'NF { n++; if (n <= 5) s = s (n > 1 ? ", " : "") $0 }
    END { if (n > 5) s = s " (+" (n - 5) " more)"; printf "%s", s }'
}

# A SHA-stamped, copy-pasteable record of what this run actually verified —
# the basis you can paste to attest "these checks passed on this exact commit".
# Deterministic and network-free (no timestamp/host): the SHA is the stamp.
attestation() {
  local sha; sha="$(git rev-parse --verify --short=12 HEAD 2>/dev/null || true)"
  local hp=0 hf=0 sf=0 r
  for r in "${RESULTS[@]:-}"; do
    [ -n "$r" ] || continue
    case "${r%%|*}" in
      ok)        hp=$((hp + 1)) ;;
      fail)      hf=$((hf + 1)) ;;
      soft-fail) sf=$((sf + 1)) ;;
    esac
  done
  local total=$((hp + hf)) verdict="${VERDICT:-passed}"
  [ -n "$VERDICT" ] || { [ "$FAIL" -ne 0 ] && verdict="FAILED"; }
  local line="portable-ci attestation: $verdict"
  # A shard run's own line must NEVER carry the attestation prefix: it covers 1/K of the suite, and any
  # reader (human, regex, a judge gate) keying on the prefix would take it for a full-suite pass.
  [ -n "$SHARD_COUNT" ] && line="portable-ci shard-result: $verdict"
  [ -n "$sha" ] && line="$line @ $sha"
  line="$line · $hp/$total checks"
  [ "$sf" -gt 0 ] && line="$line · $sf advisory finding(s)"
  [ "$SKIPPED" -gt 0 ] && line="$line · skipped by path predicate: $SKIPPED_NAMES"
  [ -n "$SINCE" ] && line="$line · scoped to $SINCE"
  # Everything below is APPENDED: the prefix above is a stable, grep-able contract.
  if [ "$verdict" = "FAILED" ] && [ -n "$FAILED_IDS" ]; then
    line="$line · failing tests: $(_ids_summary "$FAILED_IDS")"
  fi
  if [ "$verdict" = "passed-on-rerun" ]; then
    local fl="${PREV_FLAKED_STEPS:-unknown}"
    [ -n "$PREV_FLAKED_TESTS" ] && fl="$fl; tests: $(_ids_summary "$PREV_FLAKED_TESTS")"
    line="$line · flaked: $fl"
  fi
  [ -n "$SHARD_COUNT" ] && line="$line · shard $SHARD_INDEX/$SHARD_COUNT · NOT a verdict (only ci attest-merge attests a sharded run)"
  [ -n "$RECORD_PATH" ] && line="$line · record: $RECORD_PATH"
  printf '%s%s%s\n' "$C_DIM" "$line" "$C_RESET"
}

# Minimal JSON string escaping (backslash and double-quote) so descriptions and
# refs with odd characters can't break the payload. Keeps the publish path
# dependency-free (no jq needed just to POST a status).
_json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Resolve a GitHub token from the usual places (env, then gh CLI). Echoes empty
# if none is available.
_resolve_token() {
  local t="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  if [ -z "$t" ] && command -v gh >/dev/null 2>&1; then t="$(gh auth token 2>/dev/null || true)"; fi
  printf '%s' "$t"
}

# ---------- GitHub commit status (Claude Code CI-indicator integration) ----------
publish_status() {
  local state="success"; [ "$FAIL" -ne 0 ] && state="failure"
  local token; token="$(_resolve_token)"
  if [ -z "$token" ]; then
    echo "portable-ci: no GITHUB_TOKEN/GH_TOKEN and no gh auth — skipping status publish" >&2
    return 0
  fi
  local owner_repo owner repo sha
  owner_repo="$(resolve_repo)"
  if [ -z "$owner_repo" ]; then
    echo "portable-ci: could not determine owner/repo from the git remote — set PORTABLE_CI_REPO=owner/repo (or --repo owner/repo)" >&2
    return 0
  fi
  owner="${owner_repo%%/*}"; repo="${owner_repo#*/}"
  sha="$(git rev-parse HEAD)"

  local ctx desc url payload
  ctx="$(effective_context)"
  desc="$(status_description)"
  url=""
  if in_github_actions && [ -n "${GITHUB_SERVER_URL:-}" ] && [ -n "${GITHUB_RUN_ID:-}" ]; then
    url="$GITHUB_SERVER_URL/$owner/$repo/actions/runs/$GITHUB_RUN_ID"
  fi
  payload="{\"state\":\"$state\",\"context\":\"$(_json_escape "$ctx")\",\"description\":\"$(_json_escape "$desc")\""
  [ -n "$url" ] && payload="$payload,\"target_url\":\"$(_json_escape "$url")\""
  payload="$payload}"

  # Send the body from a FILE, not from `-d "$payload"`.
  #
  # `-d` puts the JSON in argv, and on Git Bash / MSYS a native curl.exe gets argv
  # re-encoded from UTF-8 to the ANSI codepage. `status_description` contains "·"
  # (U+00B7), so the bytes on the wire became invalid UTF-8 and GitHub answered
  # 400 "Problems parsing JSON" — while the identical body sent from a file
  # succeeds. Measured on Windows 2026-08-12: `-d` with "·" → 400; `-d` with an
  # ASCII separator → 201; `--data-binary @file` with "·" → 201. Adding
  # Content-Type changed nothing, so this is argv encoding, not the header.
  #
  # A file removes the whole class rather than this one instance: any non-ASCII
  # reaching the payload — from a step name, a branch name, a repo name — failed
  # the same way. Swapping "·" for an ASCII separator would have hidden that.
  # Explicit if-then-else, not `A && B || C`: shellcheck flags that form (SC2015)
  # and it is genuinely wrong here — if the SECOND mktemp fails, C runs while the
  # first temp file is already created, so the failure path leaked it.
  local body err code
  if ! body="$(mktemp)"; then
    echo "portable-ci: could not create a temp file for the status payload" >&2
    return 0
  fi
  if ! err="$(mktemp)"; then
    rm -f "$body"
    echo "portable-ci: could not create a temp file for the status payload" >&2
    return 0
  fi
  printf '%s' "$payload" > "$body"
  code="$(curl -sS -o "$err" -w '%{http_code}' -X POST \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.github+json" \
    -H "Content-Type: application/json" \
    "https://api.github.com/repos/$owner/$repo/statuses/$sha" \
    --data-binary @"$body" 2>/dev/null)"
  if [ "$code" = "201" ]; then
    printf 'portable-ci: published %s status (%s) for %s — %s\n' "$state" "$ctx" "${sha:0:12}" "$desc"
  else
    # Report what GitHub SAID. This previously hardcoded "need a token with
    # repo:status scope" for every non-201 — a guess presented as a diagnosis, and
    # wrong for the 400 above: it sent a reader to check a token that was correct.
    local msg
    msg="$(sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$err" 2>/dev/null | head -1)"
    if [ -n "$msg" ]; then
      printf 'portable-ci: status publish failed (HTTP %s) — GitHub said: %s\n' "$code" "$msg" >&2
    else
      printf 'portable-ci: status publish failed (HTTP %s) — no message in the response body\n' "$code" >&2
    fi
    case "$code" in
      401|403) printf '  401/403 here usually means the token lacks "repo:status" (or "public_repo").\n' >&2 ;;
      404)     printf '  404 usually means the token cannot see %s/%s, or HEAD is not pushed yet.\n' "$owner" "$repo" >&2 ;;
    esac
  fi
  rm -f "$body" "$err"
}

# ---------- read back what GitHub actually has (`ci status`) ----------
# Answers "is the green light real hosted CI, or a local portable-ci backup?"
# for HEAD, by listing both check runs (Actions/apps = hosted) and commit
# statuses (where our backups live) and labelling each one.
status_report() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "portable-ci: \`ci status\` needs jq to parse GitHub's API — install jq and retry." >&2
    return 2
  fi
  local token; token="$(_resolve_token)"
  if [ -z "$token" ]; then
    echo "portable-ci: no GITHUB_TOKEN/GH_TOKEN and no gh auth — can't read GitHub status" >&2
    return 1
  fi
  local owner_repo owner repo sha
  owner_repo="$(resolve_repo)"
  if [ -z "$owner_repo" ]; then
    echo "portable-ci: could not determine owner/repo — set PORTABLE_CI_REPO=owner/repo (or --repo owner/repo)" >&2
    return 1
  fi
  owner="${owner_repo%%/*}"; repo="${owner_repo#*/}"
  sha="$(git rev-parse --verify HEAD 2>/dev/null)"
  if [ -z "$sha" ]; then echo "portable-ci: not a git repo / no commit at HEAD" >&2; return 1; fi

  local api="https://api.github.com/repos/$owner/$repo/commits/$sha"
  local checks statuses
  checks="$(curl -sS -H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json" "$api/check-runs" 2>/dev/null)"
  statuses="$(curl -sS -H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json" "$api/status" 2>/dev/null)"

  printf '%sportable-ci status%s for %s %s(%s)%s\n\n' \
    "$C_BOLD" "$C_RESET" "${sha:0:12}" "$C_DIM" "$owner/$repo" "$C_RESET"

  local hosted_n=0 backup_n=0 other_n=0 origin name state detail glyph
  # Check runs are always hosted (GitHub Actions or a GitHub App).
  while IFS=$'\t' read -r name state _; do
    [ -n "$name" ] || continue
    hosted_n=$((hosted_n + 1))
    glyph="$(_state_glyph "$state")"
    printf '  %s  %-22s %shosted (Actions/app)%s  %s\n' "$glyph" "$name" "$C_DIM" "$C_RESET" "$state"
  done < <(printf '%s' "$checks" | jq -r '.check_runs[]? | [.name, (.conclusion // .status // "pending")] | @tsv')

  # Commit statuses: this is where a portable-ci backup lands. Classify each.
  while IFS=$'\t' read -r name state detail; do
    [ -n "$name" ] || continue
    case "$name" in
      */local) origin="local backup" ;;
      *) case "$detail" in "local backup"*) origin="local backup" ;; *) origin="commit status" ;; esac ;;
    esac
    if [ "$origin" = "local backup" ]; then backup_n=$((backup_n + 1)); else other_n=$((other_n + 1)); fi
    glyph="$(_state_glyph "$state")"
    printf '  %s  %-22s %s%-19s%s  %s\n' "$glyph" "$name" "$C_DIM" "$origin" "$C_RESET" "${detail:-$state}"
  done < <(printf '%s' "$statuses" | jq -r '.statuses[]? | [.context, .state, (.description // "")] | @tsv')

  if [ $((hosted_n + backup_n + other_n)) -eq 0 ]; then
    printf '  %sno checks or statuses recorded for this commit.%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi

  printf '\n%ssummary:%s %s hosted, %s local backup, %s other\n' \
    "$C_BOLD" "$C_RESET" "$hosted_n" "$backup_n" "$other_n"
  # The whole point: warn when nothing but a local backup vouches for this commit.
  if [ "$hosted_n" -eq 0 ] && [ "$other_n" -eq 0 ] && [ "$backup_n" -gt 0 ]; then
    printf '%s⚠ hosted CI has not verified this commit — the only checks here are local portable-ci backups.%s\n' \
      "$C_RED" "$C_RESET"
  fi
}

# Map a GitHub state/conclusion to a ✓/✗/• glyph.
_state_glyph() {
  case "$1" in
    success) printf '%s✓%s' "$C_GREEN" "$C_RESET" ;;
    failure|error|cancelled|timed_out) printf '%s✗%s' "$C_RED" "$C_RESET" ;;
    *) printf '%s•%s' "$C_DIM" "$C_RESET" ;;
  esac
}

# Pull an integer value for a top-level JSON key out of a flat response body,
# without a jq dependency (the billing response is a small, well-known shape:
# a handful of top-level int fields — no nesting worth a real parser for).
_json_num() {
  printf '%s' "$2" | grep -o "\"$1\"[[:space:]]*:[[:space:]]*[0-9][0-9]*" | head -1 | grep -o '[0-9]*$'
}

# ---------- Actions quota preflight (`ci quota`) ----------
# On a private repo, exhausted Actions minutes don't fail loudly — a job never
# schedules and GitHub still records a red "failure" in ~0s (see the `ci status`
# hosted-vs-backup split for the flip side of this same problem). Checking
# quota BEFORE relying on a hosted result avoids chasing a false failure. Exit
# codes mirror `step`/`status`: 0 = quota available, 1 = exhausted (compose it:
# `ci quota || use the local ci run verdict`), 2 = couldn't determine.
quota_report() {
  local token; token="$(_resolve_token)"
  if [ -z "$token" ]; then
    echo "portable-ci: no GITHUB_TOKEN/GH_TOKEN and no gh auth — can't check Actions quota (needs a token that can read billing: a classic PAT, or a fine-grained token with Plan: read)" >&2
    return 2
  fi
  local owner_repo owner
  owner_repo="$(resolve_repo)"
  if [ -z "$owner_repo" ]; then
    echo "portable-ci: could not determine owner/repo — set PORTABLE_CI_REPO=owner/repo (or --repo owner/repo)" >&2
    return 2
  fi
  owner="${owner_repo%%/*}"

  # The billing endpoint differs for a personal account vs an organization;
  # `owner` could be either, so try user first and fall back to org.
  local resp code body
  resp="$(curl -sS -w '\n%{http_code}' -H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/users/$owner/settings/billing/actions" 2>/dev/null)"
  code="${resp##*$'\n'}"; body="${resp%$'\n'*}"
  if [ "$code" != "200" ]; then
    resp="$(curl -sS -w '\n%{http_code}' -H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json" \
      "https://api.github.com/orgs/$owner/settings/billing/actions" 2>/dev/null)"
    code="${resp##*$'\n'}"; body="${resp%$'\n'*}"
  fi
  if [ "$code" != "200" ]; then
    printf 'portable-ci: could not read Actions billing for %s (HTTP %s) — needs a token that can read billing (classic PAT, or a fine-grained token with Plan: read)\n' "$owner" "$code" >&2
    return 2
  fi

  local included used remaining
  included="$(_json_num included_minutes "$body")"
  used="$(_json_num total_minutes_used "$body")"
  if [ -z "$included" ] || [ -z "$used" ]; then
    echo "portable-ci: unexpected billing response shape for $owner" >&2
    return 2
  fi
  remaining=$((included - used))
  printf '%sportable-ci quota%s: %s/%s Actions minutes used for %s — %s remaining\n' \
    "$C_BOLD" "$C_RESET" "$used" "$included" "$owner" "$remaining"
  if [ "$remaining" -le 0 ]; then
    # shellcheck disable=SC2016  # backticks are literal hint text, not substitution
    printf '%s⚠ no Actions minutes left — hosted CI will not schedule; rely on `ci run` / `ci status` instead.%s\n' \
      "$C_RED" "$C_RESET"
    return 1
  fi
}

# ---------- config scaffolder (`ci init`) ----------
# Detect the project's toolchain and write a ready-to-run .localci, so users
# never have to hand-write the config or read the format docs first.
init_config() {
  local target="$CONFIG"
  if [ -e "$target" ]; then
    echo "portable-ci: $target already exists; leaving it alone. Edit it directly, or remove it and re-run \`ci init\`." >&2
    exit 1
  fi

  local -a detected=()
  local kind="generic"
  if [ -f pyproject.toml ] || [ -f setup.py ] || ls ./*.py >/dev/null 2>&1; then
    kind="python"
    command -v ruff   >/dev/null 2>&1 && detected+=('step "lint"  ruff check .')
    command -v mypy   >/dev/null 2>&1 && detected+=('step "types" mypy .')
    command -v pytest >/dev/null 2>&1 && detected+=('step "test"  pytest -q')
  fi
  if [ -f package.json ]; then
    kind="node"
    local s
    for s in lint typecheck test; do
      if node -e "process.exit((require('./package.json').scripts||{})['$s']?0:1)" 2>/dev/null; then
        detected+=("step \"$s\"  npm run $s --silent")
      fi
    done
  fi

  # Backticks below are literal help text in the generated file, not command
  # substitution — printf prints them verbatim.
  # shellcheck disable=SC2016
  {
    printf '# portable-ci config — each `step "name" command...` runs one check.\n'
    printf '# Any non-zero exit fails the run. Compound commands: step "build" bash -c "make && make test".\n'
    printf '# Regenerate examples any time with `ci init` (into a fresh file). Docs: run `ci --help`.\n\n'
    if [ "${#detected[@]}" -gt 0 ]; then
      printf '# Detected a %s project — these were filled in from tools found on your PATH.\n' "$kind"
      printf '# Edit the commands to match how your project actually runs its checks.\n'
      printf '%s\n' "${detected[@]}"
    else
      printf '# No toolchain auto-detected — uncomment and edit the checks your project needs.\n'
      printf '# step "lint"  ruff check src/\n'
      printf '# step "types" mypy\n'
      printf '# step "test"  pytest -q\n'
    fi
    printf '\n# Cap slow steps so a hung check cannot hang the run (needs a `timeout` binary):\n'
    printf '# step_timeout 300\n'
    printf '\n# Changed-files scoping (with `ci run --since origin/main`):\n'
    printf '# step "changed" bash -c '"'"'[ -z "$CI_CHANGED_FILES" ] || ruff check $CI_CHANGED_FILES'"'"'\n'
  } > "$target"

  printf '%sportable-ci:%s wrote %s' "$C_BOLD" "$C_RESET" "$target"
  [ "${#detected[@]}" -gt 0 ] && printf ' with %s detected check(s)' "${#detected[@]}"
  printf '.\n'
  echo "Review it, then run: ci run"
  echo "Tip: \`ci install-hook pre-push\` runs these checks on every push — your"
  echo "     verdict locally, before GitHub Actions is ever in the picture."
  echo "     Coding with an agent? \`ci install-hook claude\` runs them inside its loop."
}

# ---------- Claude Code agent hooks (`ci install-hook claude`) ----------
# Wire portable-ci into an AI coding agent's OWN loop, not just git's. `ci run`
# already produces the verdict; this delivers it at the two moments an agent can
# hand back unchecked code:
#   • PreToolUse on `git commit` — the agent's commit is blocked unless ci run passes.
#   • Stop (turn end) with a DIRTY worktree — ci run runs; a clean tree is skipped,
#     so a no-op turn costs nothing.
# Both honour PORTABLE_CI_HOOKS_OFF (set it non-empty to disable without editing
# the file). The agent must be able to find `ci` on its PATH.
#
# EXIT CODE MATTERS: Claude Code only *blocks* a PreToolUse/Stop hook on exit 2.
# `ci run` exits 1 on failure, which the hooks contract treats as a non-blocking
# error — Claude would proceed and the commit would go through anyway. So a
# failing check is translated to exit 2 with `ci run || exit 2`; that is what
# makes the hook actually gate.
CLAUDE_SETTINGS=".claude/settings.json"
# shellcheck disable=SC2016  # literal command template for the hook JSON — must NOT expand here
CLAUDE_PRE_CMD='[ -n "$PORTABLE_CI_HOOKS_OFF" ] || ci run || exit 2'
# shellcheck disable=SC2016  # literal command template for the hook JSON — must NOT expand here
CLAUDE_STOP_CMD='[ -n "$PORTABLE_CI_HOOKS_OFF" ] && exit 0; if [ -n "$(git status --porcelain 2>/dev/null)" ]; then ci run || exit 2; fi'

# The literal file written when jq is absent AND no settings file exists yet.
# Kept byte-for-byte equivalent (modulo formatting) to what the jq merge below
# produces, so both paths install the same hooks.
_claude_hooks_literal() {
  cat <<'JSON'
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          { "type": "command", "command": "[ -n \"$PORTABLE_CI_HOOKS_OFF\" ] || ci run || exit 2", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "[ -n \"$PORTABLE_CI_HOOKS_OFF\" ] && exit 0; if [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then ci run || exit 2; fi", "timeout": 300 }
        ]
      }
    ]
  }
}
JSON
}

install_claude_hooks() {
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
  if command -v jq >/dev/null 2>&1; then
    # Merge idempotently into whatever is already there — never clobber a user's
    # other hooks, and never duplicate ours on a re-run (keyed on the command).
    local base='{}' after
    [ -f "$CLAUDE_SETTINGS" ] && base="$(cat "$CLAUDE_SETTINGS")"
    after="$(printf '%s' "$base" | jq \
      --arg pre "$CLAUDE_PRE_CMD" --arg stop "$CLAUDE_STOP_CMD" '
      .hooks //= {} | .hooks.PreToolUse //= [] | .hooks.Stop //= [] |
      (if ([.hooks.PreToolUse[]?.hooks[]?.command] | index($pre)) then . else
        .hooks.PreToolUse += [{matcher:"Bash(git commit*)",hooks:[{type:"command",command:$pre,timeout:120}]}] end) |
      (if ([.hooks.Stop[]?.hooks[]?.command] | index($stop)) then . else
        .hooks.Stop += [{hooks:[{type:"command",command:$stop,timeout:300}]}] end)
    ' 2>/dev/null)" || {
      echo "portable-ci: $CLAUDE_SETTINGS is not valid JSON — fix or remove it and retry." >&2
      return 2
    }
    if [ "$(printf '%s' "$base" | jq -S . 2>/dev/null)" = "$(printf '%s' "$after" | jq -S .)" ]; then
      echo "portable-ci: Claude Code hooks already present in $CLAUDE_SETTINGS — nothing to do."
      return 0
    fi
    printf '%s\n' "$after" > "$CLAUDE_SETTINGS"
  else
    # No jq: safe to create, but not to merge. Refuse to touch an existing file.
    if [ -e "$CLAUDE_SETTINGS" ]; then
      echo "portable-ci: $CLAUDE_SETTINGS exists and jq isn't installed to merge into it safely." >&2
      echo "  Install jq and re-run, or add these hooks by hand:" >&2
      _claude_hooks_literal >&2
      return 2
    fi
    _claude_hooks_literal > "$CLAUDE_SETTINGS"
  fi
  echo "portable-ci: wrote Claude Code agent hooks to $CLAUDE_SETTINGS"
  echo "  • before every 'git commit' (PreToolUse): ci run must pass"
  echo "  • when a turn ends with a dirty worktree (Stop): ci run"
  echo "portable-ci: needs 'ci' on the agent's PATH. Disable with PORTABLE_CI_HOOKS_OFF=1."
  return 0
}

# ---------- git hook installer ----------
install_hook() {
  local hook="${1:-pre-push}"
  case "$hook" in
    pre-push|pre-commit) ;;
    claude) install_claude_hooks; return $? ;;
    *) echo "portable-ci: hook must be pre-push, pre-commit, or claude" >&2; exit 2 ;;
  esac
  local dir; dir="$(git rev-parse --git-path hooks 2>/dev/null)" || { echo "portable-ci: not a git repo" >&2; exit 2; }
  mkdir -p "$dir"
  local path="$dir/$hook"
  if [ -e "$path" ] && ! grep -q "portable-ci managed hook" "$path" 2>/dev/null; then
    echo "portable-ci: $path already exists and is not managed by portable-ci; leaving it alone." >&2
    exit 1
  fi
  # Two hook bodies. pre-push gets stdin (the pushed ref range); pre-commit does not.
  if [ "$hook" = "pre-push" ]; then
    cat > "$path" <<'HOOK'
#!/usr/bin/env bash
# portable-ci managed hook — runs .localci before the git action proceeds, so
# you get your CI verdict locally *before* pushing (and before GitHub Actions).

# --- sanitise git's hook environment BEFORE running any check -----------------
# Git exports GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE / GIT_COMMON_DIR (and,
# on push, GIT_QUARANTINE_PATH) to hooks. Leaving them set means every `git`
# subprocess a check spawns inherits a repo pointer — which does two bad things:
#
#   1. `git` succeeds even with cwd outside any repository, silently removing
#      the precondition of any test that asserts "this is not a git repo".
#   2. A test that runs `git add` against what it believes is its own temp repo
#      writes to the REAL index instead. Observed 2026-07-20 in a consumer:
#      credential-gate fixtures (including a PEM private key) ended up staged in
#      the actual repository. Nothing was committed, but only because that
#      repo's own credential gate caught it.
#
# Hooks run from the top level of the working tree, so unsetting these makes
# git resolve from cwd — which is both correct and what a bare `ci run` sees.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX       GIT_QUARANTINE_PATH GIT_INTERNAL_GETTEXT_TEST_FALLBACKS

# --- derive --since from the range actually being pushed ----------------------
# Git feeds pre-push `<local ref> <local sha> <remote ref> <remote sha>` on
# stdin, one line per ref. That is the only place the pushed range is known
# unambiguously, so use it: checks get $CI_CHANGED_FILES scoped to what this
# push would land, and advisory steps (an LLM review, say) see the real diff
# instead of nothing.
#
# A zero remote sha means the branch is new upstream — there is no REMOTE
# baseline. Previously that meant no --since at all and an unscoped run, which
# is safe but made every FIRST push of a branch pay the full suite even when
# it was docs-only (observed in a consumer: five first-pushes in one afternoon,
# ~20 minutes each, all markdown). So for a new branch the baseline is the
# merge-base with the default branch (origin/HEAD, else origin/<init.defaultBranch>,
# origin/main, origin/master): exactly the diff the PR will show (GitHub's PR
# diff is three-dot, i.e. merge-base..branch). If none of that resolves, the run
# stays unscoped — still the safe direction; `git remote set-head origin -a`
# fixes a repo with a non-standard default branch.
#
# KNOWN LIMITS, unchanged by this: the FIRST non-delete ref wins, so a push of
# several refs is scoped to the first one's baseline while the checks run
# against the single checked-out tree; and a force-push to an existing ref
# scopes to the OLD remote sha, which after a history rewrite may under-scope.
# Both are pre-existing; neither can turn a skip silent (see step_unless_only).
ZERO=0000000000000000000000000000000000000000
SINCE_ARG=()
refs_seen=0
non_delete_seen=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  refs_seen=$((refs_seen + 1))
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion — nothing to check
  if [ "$non_delete_seen" -eq 0 ]; then
    non_delete_seen=1                             # first non-delete ref wins for --since
    if [ -n "${remote_sha:-}" ] && [ "$remote_sha" != "$ZERO" ]; then
      SINCE_ARG=(--since "$remote_sha")
    else
      _def="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
      if [ -z "$_def" ]; then
        _idb="$(git config --get init.defaultBranch 2>/dev/null || true)"
        for _c in ${_idb:+origin/$_idb} origin/main origin/master; do
          if git rev-parse -q --verify "$_c^{commit}" >/dev/null 2>&1; then _def="$_c"; break; fi
        done
      fi
      if [ -n "$_def" ] && _base="$(git merge-base "$local_sha" "$_def" 2>/dev/null)" && [ -n "$_base" ]; then
        SINCE_ARG=(--since "$_base")
        echo "portable-ci: new branch upstream — scoping to merge-base with $_def (${_base:0:12})" >&2
      fi
    fi
  fi
done

# --- a delete-only push has nothing to check ---------------------------------
# A push that ONLY deletes refs lands no commits, so no check can have an
# opinion about it. Worse, the loop above `continue`s past every deletion, so
# SINCE_ARG stays empty and the run is UNSCOPED — deleting a branch was paying
# for the whole suite. Observed in a consumer: removing an already-merged branch
# took ~6.5 minutes and then FAILED, because a concurrent worktree rewrote the
# shared working tree while the suite ran against it. A red verdict on a push
# that cannot change any code is noise, and noise on a gate teaches --no-verify.
#
# TWO GUARDS, because the dangerous failure of an exemption is firing when it
# should not and silently turning the gate into a no-op that still exits 0:
#   * refs_seen -gt 0     — empty or unparseable stdin means we observed NOTHING,
#                           not a delete-only push. Run the checks. Without this,
#                           any later change that breaks the read loop disables
#                           the hook everywhere while still looking green.
#   * non_delete_seen -eq 0 — a MIXED push (delete one ref, update another) still
#                           runs. Only deletions-and-nothing-else are exempt.
if [ "$refs_seen" -gt 0 ] && [ "$non_delete_seen" -eq 0 ]; then
  echo "portable-ci: delete-only push — no commits to check, skipping .localci" >&2
  exit 0
fi

echo "portable-ci: running .localci before push — your pre-Actions verdict" >&2
exec ci run "${SINCE_ARG[@]+"${SINCE_ARG[@]}"}"
HOOK
  else
    cat > "$path" <<'HOOK'
#!/usr/bin/env bash
# portable-ci managed hook — runs .localci before the git action proceeds.
# See the pre-push hook for why the git environment is unset: a check's `git`
# subprocesses must not inherit the hook's repo pointers, or a test can write to
# the real index instead of its own temp one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX       GIT_QUARANTINE_PATH
echo "portable-ci: running .localci before commit" >&2
exec ci run
HOOK
  fi
  chmod +x "$path"
  echo "portable-ci: installed $hook hook at $path"
  echo "portable-ci: .localci now runs on every $hook — you'll see the verdict before Actions does."
}

# ---------- sharded runs (`ci run --shard I/K`) and the aggregator (`ci attest-merge`) ----------
# A shard run is an ordinary run plus: CI_SHARD_INDEX / CI_SHARD_COUNT / CI_SHARD_DIR
# exported to every step, each step's output kept as $CI_SHARD_DIR/step-<name>.out,
# and a result JSON written to .portable-ci/shard-result.json at the end. portable-ci
# knows nothing about the test runner: the repo's steps drop evidence files into
# $CI_SHARD_DIR and portable-ci hashes and records them (contract in README):
#   collect.nodes     every collected test node id, one per line (the full collection)
#   partition.plan    "<file><TAB><shard>" lines, the plan the shard selection used
#   executed.nodes    node ids this shard actually executed (from the runner's report)
#   counts            lines passed=N failed=N error=N skipped=N xfailed=N xpassed=N
#   pytest.args       the invariant part of the test command line (no file list)
#   seed              the explicit random seed
#   guards.list       repo-wide guard files (run once, in shard 0)
#   once.steps        step names that must run only in shard 0
#   member.mode       1 when the run regenerated a tracked file (not aggregable), else 0
#   step-fingerprint.out   (written by portable-ci from the step named `fingerprint`)
# A missing file is recorded as empty; the aggregator then refuses naming the check.
# Step names starting `shard-`, and the step named `fingerprint`, are plumbing: they must
# pass but are not counted in N/N.
SHARD_AGG_SCHEMA=1

_shard_tree_clean() {
  if [ -z "$(git status --porcelain -- . ':(exclude).portable-ci' 2>/dev/null | head -1)" ]; then
    printf true; else printf false; fi
}

# Called once before the first step of a sharded run.
shard_begin() {
  local top; top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  SHARD_DIR="$top/.portable-ci/shard"
  rm -rf "$SHARD_DIR" "$top/.portable-ci/shard-result.json" "$top/.portable-ci/shard-collect.nodes" \
         "$top/.portable-ci/shard-executed.nodes" "$top/.portable-ci/shard-partition.plan"
  mkdir -p "$SHARD_DIR"
  SHARD_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  SHARD_TREE_CLEAN_START="$(_shard_tree_clean)"
  export CI_SHARD_DIR="$SHARD_DIR"
}

_shard_safe_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# sha256 of stdin, hex only.
_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi
}

# sha256 of the sorted lines of a file ("" when the file is missing or empty).
_sorted_hash() {
  [ -s "$1" ] || { printf ''; return 0; }
  LC_ALL=C sort "$1" | _sha256
}

_shard_file_or_empty() { if [ -f "$SHARD_DIR/$1" ]; then tr -d '\r' < "$SHARD_DIR/$1"; fi; }

# JSON array of the non-empty lines of $1.
_json_lines_array() {
  local line sep=""
  printf '['
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s%s' "$sep" "$(_json_str "$line")"; sep=", "
  done <<EOF_JA
$1
EOF_JA
  printf ']'
}

write_shard_result() {
  local out_dir="$SHARD_DIR/.."; out_dir="$(cd "$out_dir" && pwd)"
  local res="$out_dir/shard-result.json" tmp="$out_dir/.shard-result.tmp$$"
  local sha main_sha="" behind="unknown" tree_end fp="" ch="" ph="" eh=""
  sha="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  tree_end="$(_shard_tree_clean)"
  # Behind-main check against the REMOTE (CLAUDE.md Rule 10), not a possibly stale local ref.
  main_sha="$(git ls-remote origin refs/heads/main 2>/dev/null | cut -f1 | head -1 || true)"
  if [ -n "$main_sha" ] && [ -n "$sha" ]; then
    git cat-file -e "$main_sha^{commit}" 2>/dev/null || git fetch -q origin main 2>/dev/null || true
    if git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
      if git merge-base --is-ancestor "$main_sha" "$sha" 2>/dev/null; then behind=false; else behind=true; fi
    fi
  fi
  [ -s "$SHARD_DIR/step-fingerprint.out" ] && fp="$(_sha256 < "$SHARD_DIR/step-fingerprint.out")"
  ch="$(_sorted_hash "$SHARD_DIR/collect.nodes")"
  ph="$(_sorted_hash "$SHARD_DIR/partition.plan")"
  eh="$(_sorted_hash "$SHARD_DIR/executed.nodes")"
  [ -f "$SHARD_DIR/collect.nodes" ]   && cp "$SHARD_DIR/collect.nodes"   "$out_dir/shard-collect.nodes"
  [ -f "$SHARD_DIR/executed.nodes" ]  && cp "$SHARD_DIR/executed.nodes"  "$out_dir/shard-executed.nodes"
  [ -f "$SHARD_DIR/partition.plan" ]  && cp "$SHARD_DIR/partition.plan"  "$out_dir/shard-partition.plan"
  # counts: passed=N ... -> {"passed": N, ...}; absent -> all null
  local counts="" k v
  for k in passed failed error skipped xfailed xpassed; do
    v="$(_shard_file_or_empty counts | sed -n "s/^$k=\\([0-9][0-9]*\\)\$/\\1/p" | head -1)"
    counts="$counts${counts:+, }\"$k\": ${v:-null}"
  done
  # step_results: {"name": "pass|FAIL|advisory-..."}
  local sr="" r name st
  for r in "${STEP_RECS[@]:-}"; do
    [ -n "$r" ] || continue
    name="$(printf '%s' "$r" | sed -n 's/^{"name": "\(.*\)", "status": "[^"]*".*/\1/p')"
    st="$(printf '%s' "$r" | sed -n 's/^{"name": ".*", "status": "\([^"]*\)".*/\1/p')"
    sr="$sr${sr:+, }\"$name\": \"$st\""
  done
  local flaked=""
  if [ "$VERDICT" = "passed-on-rerun" ]; then
    flaked="${PREV_FLAKED_STEPS:-unknown}"
    [ -n "$PREV_FLAKED_TESTS" ] && flaked="$flaked; tests: $(_ids_summary "$PREV_FLAKED_TESTS")"
  fi
  {
    printf '{\n'
    printf '  "schema": %s,\n' "$SHARD_AGG_SCHEMA"
    printf '  "kind": "portable-ci-shard-result",\n'
    printf '  "portable_ci_version": %s,\n' "$(_json_str "$VERSION")"
    printf '  "shard_index": %s,\n' "$SHARD_INDEX"
    printf '  "shard_count": %s,\n' "$SHARD_COUNT"
    printf '  "head_sha": %s,\n' "$(_json_str "$sha")"
    printf '  "tree_clean_start": %s,\n' "$SHARD_TREE_CLEAN_START"
    printf '  "tree_clean": %s,\n' "$tree_end"
    printf '  "main_sha": %s,\n' "$(_json_str "$main_sha")"
    printf '  "behind_main": "%s",\n' "$behind"
    printf '  "env_fingerprint": %s,\n' "$(_json_str "$fp")"
    printf '  "collect_hash": %s,\n' "$(_json_str "$ch")"
    printf '  "collect_nodes_file": "shard-collect.nodes",\n'
    printf '  "partition_hash": %s,\n' "$(_json_str "$ph")"
    printf '  "executed_nodes_hash": %s,\n' "$(_json_str "$eh")"
    printf '  "executed_nodes_file": "shard-executed.nodes",\n'
    printf '  "pytest_args": %s,\n' "$(_json_str "$(_shard_file_or_empty pytest.args | head -1)")"
    printf '  "seed": %s,\n' "$(_json_str "$(_shard_file_or_empty seed | head -1)")"
    printf '  "guard_files": %s,\n' "$(_json_lines_array "$(_shard_file_or_empty guards.list | LC_ALL=C sort)")"
    printf '  "once_steps": %s,\n' "$(_json_lines_array "$(_shard_file_or_empty once.steps | LC_ALL=C sort)")"
    printf '  "counts": {%s},\n' "$counts"
    printf '  "step_results": {%s},\n' "$sr"
    printf '  "verdict": "%s",\n' "$VERDICT"
    printf '  "flaked": %s,\n' "$(_json_str "$flaked")"
    printf '  "failed_tests": %s,\n' "$(_json_lines_array "$FAILED_IDS")"
    printf '  "member_mode": %s,\n' "$(_json_str "$(_shard_file_or_empty member.mode | head -1)")"
    printf '  "exit": %s,\n' "$FAIL"
    printf '  "started": "%s",\n' "$SHARD_STARTED"
    printf '  "finished": "%s"\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '}\n'
  } > "$tmp" 2>/dev/null
  if ! mv "$tmp" "$res" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null
    printf 'portable-ci: warning: could not write the shard result %s\n' "$res" >&2
    return 1
  fi
  printf 'portable-ci: shard result: %s\n' "$res"
}

# ---------- the aggregator ----------
# `ci attest-merge [--head SHA] R1.json ... Rk.json`. A script, never a model: it
# compares fields of the per-shard result JSON and prints ONE attestation line only
# if every identity check holds (checks A..H, spec: Sharded verdict identity checks).
#   A same commit, clean tree, not behind main      B same environment fingerprint
#   C same collection                               D a true partition (no drop/dup)
#   E same pytest args and seed                     F guards run once, in the guards shard
#   G every shard present, exit 0, no failed step   H provenance: known schema, one runner version
# On any failure: one `REFUSED [X]` line per failed check (first = lowest letter) on
# stderr, nothing on stdout, exit 1.
declare -a AG_FAILS=()
AG_INCOMPLETE=0   # 1 once the SET of shards is known to be wrong (missing/extra/duplicate)
_ag_fail() { AG_FAILS+=("$1|$2"); }
# The shard set itself is wrong: record it as G and skip the partition checks, which
# would only restate the same fault as a (derivative) D/F failure.
_ag_incomplete() { AG_INCOMPLETE=1; _ag_fail G "$1"; }

# Scalar field of a result file: `  "key": value,` -> value, quotes stripped.
_rj() {
  sed -n "s/^  \"$2\": \\(.*\\)\$/\\1/p" "$1" | head -1 | sed 's/,$//; s/^"//; s/"$//'
}
# Raw (unstripped) scalar: `"false"` keeps its quotes, so a string where a bare literal belongs shows.
_rjraw() {
  sed -n "s/^  \"$2\": \(.*\)\$/\1/p" "$1" | head -1 | sed 's/,$//'
}
# Array field -> one element per line.
_rj_arr() {
  _rj "$1" "$2" | sed 's/^\[//; s/\]$//' | grep -o '"[^"]*"' | sed 's/^"//; s/"$//' || true
}
# Object field -> `key=value` lines.
_rj_obj() {
  _rj "$1" "$2" | sed 's/^{//; s/}$//' | sed 's/, "/\n"/g' | sed -n 's/^"\([^"]*\)": "\{0,1\}\([^"]*\)"\{0,1\}$/\1=\2/p'
}

# Does the node list contain a node of FILE (line starting `FILE::`, literal match)?
_ag_has_file() { awk -v p="$1::" 'index($0, p) == 1 { f = 1 } END { exit !f }' "$2"; }

# sha256(path) mod K, digit by digit so it needs no big integers.
_path_shard() {
  local hex r=0 i d
  hex="$(printf '%s' "$1" | _sha256)"
  for ((i = 0; i < ${#hex}; i++)); do
    d=$((16#${hex:i:1})); r=$(( (r * 16 + d) % $2 ))
  done
  printf '%s' "$r"
}

attest_merge() {
  local want_head="" want_main="" no_main_check=0 files=() attempts=()
  local usage="usage: ci attest-merge --head <40-hex sha> [--main SHA | --no-main-check] [--failed-attempt Rf.json]... R1.json ... Rk.json"
  while [ $# -gt 0 ]; do
    case "$1" in
      --head) want_head="${2:-}"; [ $# -ge 2 ] || { echo "portable-ci: --head needs a sha" >&2; return 2; }; shift 2 ;;
      --main) want_main="${2:-}"; [ $# -ge 2 ] || { echo "portable-ci: --main needs a sha" >&2; return 2; }; shift 2 ;;
      --no-main-check) no_main_check=1; shift ;;
      --failed-attempt) attempts+=("${2:-}"); [ $# -ge 2 ] || { echo "portable-ci: --failed-attempt needs a shard result" >&2; return 2; }; shift 2 ;;
      -h|--help) echo "$usage"; return 0 ;;
      *) files+=("$1"); shift ;;
    esac
  done
  if [ "${#files[@]}" -eq 0 ]; then echo "$usage" >&2; return 2; fi
  AG_FAILS=(); AG_INCOMPLETE=0
  # A: the head being attested is REQUIRED: without it nothing says which commit the shards should be at,
  # and a set of shards from an older head would attest.
  case "$want_head" in
    *[!0-9a-f]*|'') _ag_fail A "--head <40-hex sha of the head being attested> is required (got '$want_head')" ;;
    *) [ "${#want_head}" -eq 40 ] || _ag_fail A "--head must be the full 40-char sha (got '$want_head')" ;;
  esac
  local f ok=() i n
  # G (presence): a missing/unreadable file is a missing shard, never a pass.
  for f in "${files[@]}"; do
    if [ -r "$f" ] && [ -s "$f" ]; then ok+=("$f"); else _ag_incomplete "shard result missing or unreadable: $f"; fi
  done
  n="${#ok[@]}"

  local -a idx=() cnt=() head=() tc0=() tc=() beh=() fp=() ch=() ph=() eh=() pa=() sd=() ex=() ver=() kind=() sch=() vd=()
  local -a cfile=() efile=() dir=() mm=()
  for ((i = 0; i < n; i++)); do
    f="${ok[i]}"; dir[i]="$(dirname "$f")"
    sch[i]="$(_rj "$f" schema)"; kind[i]="$(_rj "$f" kind)"; ver[i]="$(_rj "$f" portable_ci_version)"
    idx[i]="$(_rj "$f" shard_index)"; cnt[i]="$(_rj "$f" shard_count)"; head[i]="$(_rj "$f" head_sha)"
    tc0[i]="$(_rjraw "$f" tree_clean_start)"; tc[i]="$(_rjraw "$f" tree_clean)"; beh[i]="$(_rjraw "$f" behind_main)"
    fp[i]="$(_rj "$f" env_fingerprint)"; ch[i]="$(_rj "$f" collect_hash)"; ph[i]="$(_rj "$f" partition_hash)"
    eh[i]="$(_rj "$f" executed_nodes_hash)"; pa[i]="$(_rj "$f" pytest_args)"; sd[i]="$(_rj "$f" seed)"
    ex[i]="$(_rjraw "$f" exit)"; vd[i]="$(_rj "$f" verdict)"; mm[i]="$(_rj "$f" member_mode)"
    # Fixed names, never taken from the JSON (a `../` path would read an unrelated file).
    cfile[i]="${dir[i]}/shard-collect.nodes"; efile[i]="${dir[i]}/shard-executed.nodes"
  done

  # H: provenance of the inputs.
  for ((i = 0; i < n; i++)); do
    # A duplicated key would be read one way here and another by jq: refuse the file.
    local dupk; dupk="$(sed -n 's/^  "\([a-z_0-9]*\)":.*/\1/p' "${ok[i]}" | LC_ALL=C sort | uniq -d | paste -sd, -)"
    [ -z "$dupk" ] || _ag_fail H "${ok[i]}: duplicate key(s) in the result JSON: $dupk"
    if [ "$(_rj "${ok[i]}" collect_nodes_file)" != shard-collect.nodes ] || [ "$(_rj "${ok[i]}" executed_nodes_file)" != shard-executed.nodes ]; then
      _ag_fail H "${ok[i]}: collect_nodes_file/executed_nodes_file are not the fixed names"
    fi
    [ "${ver[i]}" = "$VERSION" ] || _ag_fail H "${ok[i]}: produced by portable-ci '${ver[i]}', this aggregator is $VERSION"
    if [ "${kind[i]}" != "portable-ci-shard-result" ] || [ "${sch[i]}" != "$SHARD_AGG_SCHEMA" ]; then
      _ag_fail H "${ok[i]}: not a schema-$SHARD_AGG_SCHEMA portable-ci shard result (kind='${kind[i]}' schema='${sch[i]}')"
    fi
    if [ "${ver[i]}" != "${ver[0]}" ]; then
      _ag_fail H "portable-ci runner versions differ: ${ver[0]} vs ${ver[i]} (${ok[i]})"
    fi
  done

  # A: same commit, clean tree, not behind main.
  for ((i = 0; i < n; i++)); do
    # Member mode regenerates a tracked file during the run (restored before the end), so the tree-clean samples
    # at start and end would hold while the tests ran on a modified tree: such shards are not aggregable.
    if [ -n "${mm[i]}" ] && [ "${mm[i]}" != 0 ]; then _ag_fail A "${ok[i]}: the shard ran in negatives member mode (member_mode='${mm[i]}'); a sharded verdict needs a pristine tree"; fi
    [ "${head[i]}" = "${head[0]}" ] || _ag_fail A "head_sha differs: ${head[0]} vs ${head[i]} (${ok[i]})"
    [ "${head[i]}" = "$want_head" ] || _ag_fail A "head_sha '${head[i]}' is not the head being attested ($want_head)"
    if [ "${tc0[i]}" != true ] || [ "${tc[i]}" != true ]; then _ag_fail A "${ok[i]}: working tree not clean (start=${tc0[i]} end=${tc[i]})"; fi
    [ "${beh[i]}" = '"false"' ] || _ag_fail A "${ok[i]}: behind_main=${beh[i]} (must be \"false\": head contains the remote main)"
  done
  # A, at attest time: shard-time behind_main is stale by now. Re-check the head against the CURRENT remote main.
  if [ "$no_main_check" -eq 0 ]; then
    local cur_main="$want_main"
    [ -n "$cur_main" ] || cur_main="$(git ls-remote origin refs/heads/main 2>/dev/null | cut -f1 | head -1 || true)"
    if [ -z "$cur_main" ]; then
      _ag_fail A "could not establish the current remote main at attest time (run inside a clone with origin, or pass --main SHA, or --no-main-check)"
    else
      git cat-file -e "$cur_main^{commit}" 2>/dev/null || git fetch -q origin main 2>/dev/null || true
      if ! git cat-file -e "$cur_main^{commit}" 2>/dev/null || ! git cat-file -e "$want_head^{commit}" 2>/dev/null; then
        _ag_fail A "cannot check main ${cur_main:0:12} against head ${want_head:0:12}: commit(s) not in this clone (git fetch, or --no-main-check)"
      elif ! git merge-base --is-ancestor "$cur_main" "$want_head" 2>/dev/null; then
        _ag_fail A "head ${want_head:0:12} is behind the current remote main ${cur_main:0:12} at attest time"
      fi
    fi
  fi

  # B: same environment.
  for ((i = 0; i < n; i++)); do
    case "${fp[i]}" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) [ "${#fp[i]}" -eq 64 ] || _ag_fail B "${ok[i]}: env_fingerprint is not a sha256" ;;
      *) _ag_fail B "${ok[i]}: no env_fingerprint recorded" ;;
    esac
    [ "${fp[i]}" = "${fp[0]}" ] || _ag_fail B "env_fingerprint differs: ${fp[0]:0:12} vs ${fp[i]:0:12} (${ok[i]})"
  done

  # C: same collection (and the recorded hash really is the hash of the shipped list).
  for ((i = 0; i < n; i++)); do
    [ -n "${ch[i]}" ] || _ag_fail C "${ok[i]}: no collect_hash recorded"
    [ "${ch[i]}" = "${ch[0]}" ] || _ag_fail C "collect_hash differs: ${ch[0]:0:12} vs ${ch[i]:0:12} (${ok[i]})"
    if [ ! -s "${cfile[i]}" ]; then _ag_fail C "${ok[i]}: collected node list missing (${cfile[i]})"
    elif [ "$(_sorted_hash "${cfile[i]}")" != "${ch[i]}" ]; then _ag_fail C "${ok[i]}: collect_hash does not match its node list"; fi
  done

  # E: same pytest behaviour.
  for ((i = 0; i < n; i++)); do
    [ -n "${pa[i]}" ] || _ag_fail E "${ok[i]}: no pytest_args recorded"
    [ -n "${sd[i]}" ] || _ag_fail E "${ok[i]}: no explicit seed recorded"
    [ "${pa[i]}" = "${pa[0]}" ] || _ag_fail E "pytest_args differ: '${pa[0]}' vs '${pa[i]}' (${ok[i]})"
    [ "${sd[i]}" = "${sd[0]}" ] || _ag_fail E "seed differs: '${sd[0]}' vs '${sd[i]}' (${ok[i]})"
  done

  # G: every shard present, exit 0, no failed step.
  local k0="${cnt[0]:-}" seen=" "
  for ((i = 0; i < n; i++)); do
    [ "${cnt[i]}" = "$k0" ] || _ag_fail G "shard_count differs: $k0 vs ${cnt[i]} (${ok[i]})"
    case "${idx[i]}" in ''|*[!0-9]*) _ag_fail G "${ok[i]}: bad shard_index '${idx[i]}'" ;;
      *) case "$seen" in *" ${idx[i]} "*) _ag_incomplete "shard ${idx[i]} supplied twice" ;; esac; seen="$seen${idx[i]} " ;; esac
    [ "${ex[i]}" = 0 ] || _ag_fail G "shard ${idx[i]} (${ok[i]}) exit='${ex[i]}' (must be 0)"
    case "${vd[i]}" in passed|passed-on-rerun) ;; *) _ag_fail G "shard ${idx[i]} verdict '${vd[i]}' is not passed" ;; esac
    # Allowlist, not denylist: only these statuses are acceptable (an advisory finding never fails a verdict,
    # exactly as in an unsharded run). `skipped`, TIMEOUT, anything unknown refuses.
    if _rj_obj "${ok[i]}" step_results | grep -qv '=\(pass\|advisory-pass\|advisory-fail\)$'; then _ag_fail G "shard ${idx[i]} has a step that did not pass: $(_rj_obj "${ok[i]}" step_results | grep -v '=\(pass\|advisory-pass\|advisory-fail\)$' | head -2 | paste -sd' ' -)"; fi
    [ -n "$(_rj_obj "${ok[i]}" step_results)" ] || _ag_fail G "shard ${idx[i]} recorded no steps"
    # Every shard runs the same steps, except the declared run-once ones (a missing pytest step shows here).
    if [ "$(_rj_obj "${ok[i]}" step_results | sed 's/=[^=]*$//' | grep -vxFf <(_rj_arr "${ok[i]}" once_steps) | LC_ALL=C sort)" != \
         "$(_rj_obj "${ok[0]}" step_results | sed 's/=[^=]*$//' | grep -vxFf <(_rj_arr "${ok[0]}" once_steps) | LC_ALL=C sort)" ]; then
      _ag_fail G "shard ${idx[i]} ran a different set of steps than shard ${idx[0]}"
    fi
    # Counts must be bare integers, and nothing failed or errored.
    if _rjraw "${ok[i]}" counts | grep -qE '^\{("[a-z]+": [0-9]+(, )?){6}\}$'; then
      if [ "$(_rj_obj "${ok[i]}" counts | grep -c '^\(failed\|error\)=0$')" -ne 2 ]; then _ag_fail G "shard ${idx[i]} counts show failed or errored tests"; fi
    else
      _ag_fail G "shard ${idx[i]}: counts are not six bare integers: $(_rjraw "${ok[i]}" counts)"
    fi
    # A weaker verdict must name what flaked (CLAUDE.md Rule 10: an unnamed passed-on-rerun is a fail).
    if [ "${vd[i]}" = "passed-on-rerun" ]; then
      case "$(_rj "${ok[i]}" flaked)" in *"tests: "?*) ;; *) _ag_fail G "shard ${idx[i]} is passed-on-rerun without naming the flaked test(s)" ;; esac
    fi
  done
  case "$k0" in
    ''|*[!0-9]*) _ag_fail G "shard_count is not a number: '$k0'" ;;
    *) if [ "$k0" -ne "${#files[@]}" ]; then _ag_incomplete "expected $k0 shard results, got ${#files[@]}"; fi
       local s; for ((s = 0; s < k0; s++)); do
         case "$seen" in *" $s "*) ;; *) _ag_incomplete "shard $s is missing" ;; esac
       done ;;
  esac

  # D: a true partition. Needs readable lists and a sane K; skip quietly otherwise (C/G already failed).
  if [ "$AG_INCOMPLETE" -eq 0 ]; then
  local tot=0 coll="" union
  if [ "$n" -ge 1 ] && [ -s "${cfile[0]}" ]; then
    coll="$(LC_ALL=C sort "${cfile[0]}")"; tot="$(printf '%s\n' "$coll" | grep -c . || true)"
  fi
  union="$(mktemp)"; : > "$union"
  local sum_all=0 nex nsum
  for ((i = 0; i < n; i++)); do
    [ -n "${ph[i]}" ] || _ag_fail D "${ok[i]}: no partition_hash recorded"
    [ "${ph[i]}" = "${ph[0]}" ] || _ag_fail D "partition_hash differs: ${ph[0]:0:12} vs ${ph[i]:0:12} (${ok[i]})"
    if [ ! -s "${efile[i]}" ]; then _ag_fail D "shard ${idx[i]}: executed node list missing or empty (${efile[i]})"; continue; fi
    [ "$(_sorted_hash "${efile[i]}")" = "${eh[i]}" ] || _ag_fail D "shard ${idx[i]}: executed_nodes_hash does not match its node list"
    cat "${efile[i]}" >> "$union"
    nex="$(grep -c . "${efile[i]}" || true)"
    nsum="$(_rj_obj "${ok[i]}" counts | sed -n 's/^[a-z]*=\([0-9][0-9]*\)$/\1/p' | awk '{ s += $1 } END { if (NR) print s }')"
    if [ -z "$nsum" ] || [ "$nsum" != "$nex" ]; then _ag_fail D "shard ${idx[i]}: counts sum to '${nsum:-?}' but ${nex} node ids were executed"; fi
    sum_all=$((sum_all + ${nsum:-0}))
    # Non-guard files must belong to this shard under sha256(path) mod K.
    local gl; gl="$(_rj_arr "${ok[i]}" guard_files)"
    local pth bad=""
    case "$k0" in ''|*[!0-9]*|0) ;; *)
      while IFS= read -r pth; do
        [ -n "$pth" ] || continue
        printf '%s\n' "$gl" | grep -qxF -- "$pth" && continue
        [ "$(_path_shard "$pth" "$k0")" = "${idx[i]}" ] || { bad="$pth"; break; }
      done < <(sed 's/::.*//' "${efile[i]}" | LC_ALL=C sort -u)
      [ -z "$bad" ] || _ag_fail D "shard ${idx[i]} executed a file that is not its own under sha256(path) mod $k0: $bad" ;;
    esac
  done
  if [ -s "$union" ]; then
    local dups; dups="$(LC_ALL=C sort "$union" | uniq -d | head -3 | paste -sd' ' -)"
    [ -z "$dups" ] || _ag_fail D "node id(s) executed in more than one shard (or twice): $dups"
    if [ -n "$coll" ] && [ "$(LC_ALL=C sort -u "$union" | _sha256)" != "$(printf '%s\n' "$coll" | LC_ALL=C sort -u | _sha256)" ]; then
      local miss extra
      miss="$(LC_ALL=C comm -13 <(LC_ALL=C sort -u "$union") <(printf '%s\n' "$coll" | LC_ALL=C sort -u) | head -3 | paste -sd' ' -)"
      extra="$(LC_ALL=C comm -23 <(LC_ALL=C sort -u "$union") <(printf '%s\n' "$coll" | LC_ALL=C sort -u) | head -3 | paste -sd' ' -)"
      _ag_fail D "union of executed node ids != collected set (collected-not-run: ${miss:-none}; run-not-collected: ${extra:-none})"
    fi
    [ "$sum_all" = "$tot" ] || _ag_fail D "per-shard counts total $sum_all but $tot node ids were collected"
  fi
  rm -f "$union"

  # F: guards run once, in the guards shard (shard 0); run-once steps only in shard 0.
  for ((i = 0; i < n; i++)); do
    local gl_i gl_0 pth
    gl_i="$(_rj_arr "${ok[i]}" guard_files)"; gl_0="$(_rj_arr "${ok[0]}" guard_files)"
    [ "$gl_i" = "$gl_0" ] || _ag_fail F "guard_files differ between shards (${ok[0]} vs ${ok[i]})"
    [ "$(_rj_arr "${ok[i]}" once_steps)" = "$(_rj_arr "${ok[0]}" once_steps)" ] || _ag_fail F "once_steps differ between shards (${ok[i]})"
    [ -s "${efile[i]}" ] || continue
    while IFS= read -r pth; do
      [ -n "$pth" ] || continue
      if [ "${idx[i]}" = 0 ]; then
        _ag_has_file "$pth" "${efile[i]}" || _ag_fail F "guard file $pth has no executed node in the guards shard"
      else
        ! _ag_has_file "$pth" "${efile[i]}" || _ag_fail F "guard file $pth ran in shard ${idx[i]} (guards run once, in shard 0)"
      fi
    done <<EOF_GL
$gl_i
EOF_GL
    local st
    while IFS= read -r st; do
      [ -n "$st" ] || continue
      if [ "${idx[i]}" = 0 ]; then
        _rj_obj "${ok[i]}" step_results | grep -qxF -- "$st=pass" || _ag_fail F "run-once step '$st' did not pass in shard 0"
      else
        ! _rj_obj "${ok[i]}" step_results | grep -q -- "^$st=" || _ag_fail F "run-once step '$st' ran in shard ${idx[i]} (must run only in shard 0)"
      fi
    done <<EOF_ST
$(_rj_arr "${ok[0]}" once_steps)
EOF_ST
  done

  fi # AG_INCOMPLETE

  # Attempt history: a re-run shard comes back from a fresh container as a plain `passed`, so the red attempt
  # is supplied here. Each must be a failed result of this head and shard count, and must name a failing test.
  local att att_flaked="" ai
  for att in "${attempts[@]:-}"; do
    [ -n "$att" ] || continue
    if [ ! -r "$att" ] || [ ! -s "$att" ]; then _ag_fail G "failed attempt unreadable: $att"; continue; fi
    if [ "$(_rj "$att" kind)" != "portable-ci-shard-result" ] || [ "$(_rj "$att" schema)" != "$SHARD_AGG_SCHEMA" ]; then _ag_fail H "$att: not a shard result"; continue; fi
    [ "$(_rj "$att" head_sha)" = "$want_head" ] || _ag_fail A "failed attempt $att is at head '$(_rj "$att" head_sha)', not $want_head"
    [ "$(_rj "$att" shard_count)" = "$k0" ] || _ag_fail G "failed attempt $att has shard_count '$(_rj "$att" shard_count)' (expected $k0)"
    if [ "$(_rjraw "$att" exit)" = 0 ] && [ "$(_rj "$att" verdict)" != FAILED ]; then _ag_fail G "$att is not a failed attempt (exit 0, verdict '$(_rj "$att" verdict)')"; continue; fi
    ai="$(_rj_arr "$att" failed_tests | head -5 | paste -sd, -)"
    if [ -z "$ai" ]; then _ag_fail G "failed attempt $att names no failing test (an unnamed re-run is a fail)"; continue; fi
    att_flaked="$att_flaked${att_flaked:+; }shard $(_rj "$att" shard_index): tests: $ai"
  done

  if [ "${#AG_FAILS[@]}" -gt 0 ]; then
    local first
    first="$(printf '%s\n' "${AG_FAILS[@]}" | LC_ALL=C sort -s -t'|' -k1,1 | head -1)"
    printf 'portable-ci attest-merge: REFUSED [%s]: %s\n' "${first%%|*}" "${first#*|}" >&2
    printf '%s\n' "${AG_FAILS[@]}" | LC_ALL=C sort -s -t'|' -k1,1 | tail -n +2 | while IFS='|' read -r c m; do
      printf '  also failed [%s]: %s\n' "$c" "$m" >&2
    done
    printf 'portable-ci attest-merge: no attestation issued (%s check failure(s)); re-run only the failing shard(s) at the same sha\n' "${#AG_FAILS[@]}" >&2
    return 1
  fi

  # All eight checks hold. Count checks: distinct non-plumbing step names, all passed everywhere they ran.
  local names total=0 sha12 verdict=passed flaked="" me="${BASH_SOURCE[0]:-$0}" asha=""
  names="$(for ((i = 0; i < n; i++)); do _rj_obj "${ok[i]}" step_results | sed 's/=[^=]*$//'; done | grep -v '^shard-\|^fingerprint$' | LC_ALL=C sort -u)"
  total="$(printf '%s\n' "$names" | grep -c . || true)"
  for ((i = 0; i < n; i++)); do
    if [ "${vd[i]}" = "passed-on-rerun" ]; then
      verdict="passed-on-rerun"
      flaked="$flaked${flaked:+; }shard ${idx[i]}: $(_rj "${ok[i]}" flaked)"
    fi
  done
  if [ -n "$att_flaked" ]; then verdict="passed-on-rerun"; flaked="$flaked${flaked:+; }$att_flaked"; fi
  sha12="${head[0]:0:12}"
  [ -r "$me" ] && asha="$(_sha256 < "$me")"
  local line="portable-ci attestation: $verdict @ $sha12 · $total/$total checks · sharded K=$k0 partition=${ph[0]:0:12} env=${fp[0]:0:12} seed=${sd[0]}"
  [ -n "$flaked" ] && line="$line · flaked: $flaked"
  line="$line · aggregator portable-ci@$VERSION/${asha:0:12}"
  printf '%s\n' "$line"
  local parts="" j
  # Per shard: sha256 of the result JSON / sha256 of the JSON plus both node lists (what attest-merge actually read).
  for ((j = 0; j < n; j++)); do
    parts="$parts shard${idx[j]}=$(_sha256 < "${ok[j]}" | cut -c1-12)/$(cat "${ok[j]}" "${cfile[j]}" "${efile[j]}" | _sha256 | cut -c1-12)"
  done
  printf 'shard-results (sha256 json/json+lists, post these):%s\n' "$parts"
  return 0
}

# ---------- arg parsing ----------
case "${1:-run}" in
  init)            MODE="init"; shift ;;
  doctor)          MODE="doctor"; shift ;;
  status)          MODE="status"; shift ;;
  quota)           MODE="quota"; shift ;;
  install-hook)    shift; install_hook "${1:-pre-push}"; exit $? ;;
  resolve-repo)    shift; [ "${1:-}" = "--repo" ] && REPO="$2"; resolve_repo; exit 0 ;;
  resolve-context) shift; [ "${1:-}" = "--context" ] && STATUS_CONTEXT="$2"; effective_context; exit 0 ;;
  --version|-V)    echo "portable-ci $VERSION"; exit 0 ;;
  -h|--help)       usage; exit 0 ;;
  attest-merge)    shift; attest_merge "$@"; exit $? ;;
  run)             shift ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --config)         CONFIG="$2"; CONFIG_EXPLICIT=1; shift 2 ;;
    --since)          SINCE="$2"; shift 2 ;;
    --publish-status) PUBLISH_STATUS=1; shift ;;
    --list)           SHOW_ONLY="list"; shift ;;
    --dry-run)        SHOW_ONLY="dry-run"; shift ;;
    --rerun-of)       RERUN_OF="${2:-}"; [ $# -ge 2 ] || { echo "portable-ci: --rerun-of needs a sha" >&2; exit 2; }; shift 2 ;;
    --no-lock)        LOCK_SCOPE="off"; LOCK_CLI=1; shift ;;
    --shard)
      [ $# -ge 2 ] || { echo "portable-ci: --shard needs I/K" >&2; exit 2; }
      case "$2" in
        [0-9]*/[0-9]*) SHARD_INDEX="${2%%/*}"; SHARD_COUNT="${2##*/}" ;;
        *) echo "portable-ci: --shard needs I/K (two non-negative integers), got '$2'" >&2; exit 2 ;;
      esac
      case "$SHARD_INDEX$SHARD_COUNT" in *[!0-9]*) echo "portable-ci: --shard needs I/K (two non-negative integers), got '$2'" >&2; exit 2 ;; esac
      SHARD_INDEX=$((10#$SHARD_INDEX)); SHARD_COUNT=$((10#$SHARD_COUNT))
      if [ "$SHARD_COUNT" -lt 1 ] || [ "$SHARD_INDEX" -ge "$SHARD_COUNT" ]; then
        echo "portable-ci: --shard I/K needs K >= 1 and 0 <= I < K, got '$2'" >&2; exit 2
      fi
      shift 2 ;;
    --context)        STATUS_CONTEXT="$2"; shift 2 ;;
    --repo)           REPO="$2"; shift 2 ;;
    -h|--help)        usage; exit 0 ;;
    *) echo "portable-ci: unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

# ---------- main ----------
if [ "$MODE" = "init" ]; then
  init_config
  exit 0
fi

if [ "$MODE" = "status" ]; then
  status_report
  exit $?
fi

if [ "$MODE" = "quota" ]; then
  quota_report
  exit $?
fi

# ---------- install staleness (`ci doctor`) ----------
# Compare the running VERSION against the latest published release. Advisory and
# entirely optional: no token, no network, or no `gh` simply prints nothing.
# Never fails doctor — being behind is not a broken install.
version_note() {
  command -v gh >/dev/null 2>&1 || return 0
  local latest
  latest="$(gh api repos/Munns729/portable-ci/releases/latest --jq .tag_name 2>/dev/null)" || return 0
  [ -n "$latest" ] || return 0
  local norm="${latest#v}"
  # Only compare against a SEMVER-shaped release tag. `v1` is the MOVING major
  # tag the composite action is pinned to; it can be the "latest release" and
  # normalises to `1`, which would never equal VERSION and would nag on every
  # doctor run forever. Anything not X.Y.Z is not a version claim — skip.
  case "$norm" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) return 0 ;;
  esac
  if [ "$norm" != "$VERSION" ]; then
    printf '
%sInstall%s
' "$C_BOLD" "$C_RESET"
    # shellcheck disable=SC2016  # backticks are literal hint text, not command substitution
    printf '  %s○%s running %s, latest is %s — `curl -fsSL https://raw.githubusercontent.com/Munns729/portable-ci/v1/install.sh | bash`
'       "$C_DIM" "$C_RESET" "$VERSION" "$latest"
  fi
}

if [ "$MODE" = "doctor" ]; then
  printf '%sportable-ci doctor%s — checking configured tools\n\n' "$C_BOLD" "$C_RESET"
  load_steps
  version_note
  echo
  if [ "$MISSING" -gt 0 ]; then
    printf '%s%s tool(s) missing.%s\n' "$C_RED" "$MISSING" "$C_RESET"; exit 1
  fi
  printf '%sall configured tools present.%s\n' "$C_GREEN" "$C_RESET"; exit 0
fi

if [ "$SHOW_ONLY" = "list" ]; then
  printf '%sportable-ci%s — configured checks (not run)\n' "$C_BOLD" "$C_RESET"
elif [ "$SHOW_ONLY" = "dry-run" ]; then
  printf '%sportable-ci%s — dry run; nothing will execute\n' "$C_BOLD" "$C_RESET"
fi

# ---------- recorded re-runs (`--rerun-of SHA`) ----------
# A re-run is only meaningful for the commit being checked out right now: allowing
# another sha would let a pass on one tree vouch for a failure on another. Refuse
# anything that is not exactly HEAD, before taking the lock or running a step.
if [ -z "$SHOW_ONLY" ]; then
  if [ -n "$RERUN_OF" ]; then
    _head_full="$(git rev-parse --verify HEAD 2>/dev/null || true)"
    _want_full="$(git rev-parse --verify "$RERUN_OF^{commit}" 2>/dev/null || true)"
    if [ -z "$_head_full" ] || [ -z "$_want_full" ] || [ "$_want_full" != "$_head_full" ]; then
      printf '%sportable-ci:%s --rerun-of %s refused: it must equal the current HEAD (%s)\n' \
        "$C_BOLD" "$C_RESET" "$RERUN_OF" "${_head_full:0:12}" >&2
      exit 2
    fi
  fi
  _load_previous_record
  if [ -n "$PREV_RECORD" ] && [ "$PREV_VERDICT" = "FAILED" ]; then
    if [ -n "$RERUN_OF" ]; then
      printf 'portable-ci: re-run of a failed run at this sha (%s)\n\n' "$PREV_RECORD"
    else
      printf 'portable-ci: previous run at this sha FAILED (%s)\n\n' "$PREV_RECORD"
    fi
  elif [ -n "$RERUN_OF" ] && [ -z "$PREV_RECORD" ]; then
    printf 'portable-ci: --rerun-of: no earlier record for this sha — this is judged as a first run\n\n'
  fi
fi

if [ -n "$SHARD_COUNT" ]; then
  if [ -n "$SINCE" ]; then
    echo "portable-ci: --shard and --since cannot be combined: a sharded verdict is a FULL-suite verdict" >&2; exit 2
  fi
  # Exported even for --list/--dry-run: a .localci branching on them must load.
  export CI_SHARD_INDEX="$SHARD_INDEX" CI_SHARD_COUNT="$SHARD_COUNT"
  [ -n "$SHOW_ONLY" ] || shard_begin
else
  # An UNSHARDED run must not inherit shard variables from the environment: a config branching on them
  # would silently run a subset and attest it as a whole.
  unset CI_SHARD_INDEX CI_SHARD_COUNT CI_SHARD_DIR
fi

compute_changed_files
load_steps

# --list / --dry-run already printed each step in _step_show; there's nothing to
# run, publish, or attest — a plan is not a verdict.
if [ -n "$SHOW_ONLY" ]; then exit 0; fi

echo "── portable-ci summary ──"
for r in "${RESULTS[@]:-}"; do
  [ -n "$r" ] || continue
  name="${r#*|}"
  case "${r%%|*}" in
    ok)        printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$name" ;;
    fail)      printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$name" ;;
    soft-ok)   printf '  %s✓%s %s %s(advisory)%s\n' "$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$C_RESET" ;;
    soft-fail) printf '  %s⚠%s %s %s(advisory — not blocking)%s\n' "$C_DIM" "$C_RESET" "$name" "$C_DIM" "$C_RESET" ;;
    skip)      printf '  %s↷%s %s %s(skipped — path predicate; coverage reduced)%s\n' "$C_DIM" "$C_RESET" "$name" "$C_DIM" "$C_RESET" ;;
    inert)     printf '  %s·%s %s %s(not run — its unless_only twin covered this push)%s\n' "$C_DIM" "$C_RESET" "$name" "$C_DIM" "$C_RESET" ;;
  esac
done
[ "$SKIPPED" -gt 0 ] && printf '%sskipped by path predicate: %s — this is a PARTIAL verdict.%s\n' "$C_DIM" "$SKIPPED_NAMES" "$C_RESET"
[ "$ADVISORY_FAIL" -gt 0 ] && printf '%s%s advisory finding(s) — reported, not gating.%s\n' "$C_DIM" "$ADVISORY_FAIL" "$C_RESET"

# A predicate may shrink the verdict; it may not erase it. If every HARD step was
# skipped, nothing was verified — and "0/0 checks passed" with exit 0 would post a
# GREEN commit status that a consumer keying on state (not description) reads as
# merge authority. Refuse: fail the run, say why, name the fix. Configs with only
# advisory steps and no predicates are unaffected (SKIPPED is 0 there).
_hard_ran=0
for r in "${RESULTS[@]:-}"; do
  case "${r%%|*}" in ok|fail) _hard_ran=1 ;; esac
done
if [ "$SKIPPED" -gt 0 ] && [ "$_hard_ran" -eq 0 ]; then
  printf '%s✗ every hard step was skipped by a path predicate — nothing was verified.%s\n' "$C_RED" "$C_RESET"
  printf '%s  Pair each step_unless_only with a step_when_only that runs the reduced checks.%s\n' "$C_DIM" "$C_RESET"
  FAIL=1
fi

finalize_verdict
write_run_record
[ -z "$SHARD_COUNT" ] || write_shard_result || true

[ "$PUBLISH_STATUS" -eq 1 ] && publish_status

if [ "$FAIL" -ne 0 ]; then
  printf '%sportable-ci: FAILED%s\n' "$C_RED" "$C_RESET"
elif [ "$VERDICT" = "passed-on-rerun" ]; then
  printf '%sportable-ci: passed on re-run — a WEAKER verdict: this sha failed before (see flaked: below)%s\n' "$C_GREEN" "$C_RESET"
else
  printf '%sportable-ci: passed%s\n' "$C_GREEN" "$C_RESET"
fi
attestation
exit "$FAIL"
